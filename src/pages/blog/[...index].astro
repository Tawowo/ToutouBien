---
import Base from '~/layouts/Base.astro';
import SplitTitle from '~/components/SplitTitle.astro';
import ArticleIndex from '~/components/ArticleIndex.astro';
import Icon from '~/components/Icon.astro';
import { CATEGORIES } from '~/lib/categories';
import { visibleArticles } from '~/lib/articles';

export async function getStaticPaths() {
  const articles = await visibleArticles();
  return articles.length ? [{ params: { index: undefined } }] : [];
}

const articles = await visibleArticles();
const used = CATEGORIES.filter((c) => articles.some((a) => a.data.category === c.id));
---
<Base title="Blog" description="Le carnet de ToutouBien : des articles, guides et fiches pratiques pour mieux comprendre son chien et vivre un quotidien plus serein.">
  <section class="bl-hero">
    <div class="page bl-hero__inner">
      <p class="eyebrow enter">Le carnet</p>
      <SplitTitle as="h1" text="Lire, *comprendre*, essayer." now />
      <div class="bl-hero__row enter" data-i="3">
        {
          used.length > 1 && (
            <nav class="bl-themes" aria-label="Thèmes">
              <ul role="list">
                <li><a href="/blog/" aria-current="page">Tout</a></li>
                {used.map((c) => <li><a href={`/blog/categorie/${c.id}/`}>{c.label}</a></li>)}
              </ul>
            </nav>
          )
        }
        <a class="link-arrow" href="/ressources/">Chercher dans la bibliothèque <Icon name="arrow" /></a>
      </div>
    </div>
  </section>
  <section class="section section--tight">
    <div class="page">
      <h2 class="sr-only">Articles</h2>
      <ArticleIndex articles={articles} />
    </div>
  </section>
</Base>

<style>
  .bl-hero {
    padding-block: var(--space-xl) var(--space-m);
  }

  .bl-hero__inner {
    display: grid;
    gap: var(--space-l);
  }

  .bl-hero h1 {
    font-size: var(--step-6);
    line-height: 0.9;
  }

  .bl-hero h1 :global(em) {
    color: var(--argile);
  }

  .bl-hero__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    justify-content: space-between;
    align-items: center;
  }

  .bl-themes ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    padding: 0;
    list-style: none;
  }

  .bl-themes a {
    display: inline-flex;
    align-items: center;
    min-height: 2.6rem;
    padding: 0 1.05rem;
    border: 1.5px solid color-mix(in oklab, var(--encre) 22%, transparent);
    border-radius: var(--radius-pill);
    font-size: var(--step--1);
    color: var(--encre);
    text-decoration: none;
  }

  .bl-themes a:hover,
  .bl-themes a[aria-current='page'] {
    background: var(--nuit);
    border-color: var(--nuit);
    color: var(--craie);
  }
</style>
