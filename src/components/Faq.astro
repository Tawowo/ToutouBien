---
import { buildFaq, type FaqItem } from '~/content/faq';

interface Props {
  scope: FaqItem['scope'][number];
  title?: string;
  limit?: number;
  dark?: boolean;
}
const { scope, title = 'Questions fréquentes', limit, dark = false } = Astro.props;
const items = buildFaq().filter((i) => i.scope.includes(scope)).slice(0, limit);
---
{
  items.length > 0 && (
    <section class:list={['section', 'faq', dark && 'on-dark']} aria-labelledby={`faq-${scope}`}>
      <div class="page faq__grid">
        <div class="faq__head">
          <p class="eyebrow">Avant de se lancer</p>
          <h2 id={`faq-${scope}`}>{title}</h2>
        </div>
        <div class="accordion faq__list">
          {items.map((item) => (
            <details class:list={[item.draft && 'draft']} data-faq={item.id}>
              <summary>
                {item.q}
                {item.draft && <span class="draft-badge">À valider</span>}
              </summary>
              <div class="accordion__body">
                <p>{item.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .faq__grid {
    display: grid;
    gap: var(--space-l);
  }

  @media (min-width: 60rem) {
    .faq__grid {
      grid-template-columns: 5fr 7fr;
      align-items: start;
    }

    .faq__head {
      position: sticky;
      top: 7rem;
    }
  }

  .faq__head h2 {
    margin-top: var(--space-s);
    font-size: var(--step-4);
  }
</style>
