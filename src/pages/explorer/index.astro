---
import Base from '~/layouts/Base.astro';
import SplitTitle from '~/components/SplitTitle.astro';
import DogFigure from '~/components/DogFigure.astro';
import Icon from '~/components/Icon.astro';
import { EXPERIENCES } from '~/content/explorer';
---
<Base
  title="Explorer : voir le monde à hauteur de chien"
  description="Trois expériences interactives pour mieux comprendre votre chien : le monde par le nez, la distance de confort et la lecture des signaux corporels."
  headerTheme="dark"
>
  <section class="hub on-dark grain-dark" aria-labelledby="hub-title">
    <div class="page hub__head">
      <p class="eyebrow">Explorer</p>
      <SplitTitle as="h1" id="hub-title" text="Voir le monde *à hauteur de chien*." now />
      <p class="lede">On comprend mieux en manipulant. Trois petites expériences pour ressentir ce que perçoit votre chien, et pourquoi il réagit comme il le fait.</p>
    </div>

    <ol class="page hub__list" role="list">
      {
        EXPERIENCES.map((e) => (
          <li class="hub__item">
            <a href={e.href} class:list={['hub__card', `hub__card--${e.id}`]}>
              <div class="hub__preview" aria-hidden="true">
                {e.id === 'flair' && (
                  <div class="pv-flair">
                    {Array.from({ length: 26 }, (_, i) => <span data-i={String(i % 6)} />)}
                    <i class="pv-flair__nose" />
                  </div>
                )}
                {e.id === 'distance' && (
                  <div class="pv-distance">
                    <span class="pv-distance__z pv-distance__z--a" />
                    <span class="pv-distance__z pv-distance__z--b" />
                    <span class="pv-distance__z pv-distance__z--c" />
                    <i class="pv-distance__dot" />
                  </div>
                )}
                {e.id === 'signaux' && <DogFigure class="pv-dog" wag="loose" ears="forward" tail="high" />}
              </div>
              <div class="hub__text">
                <span class="label">Expérience {e.num}</span>
                <h2>{e.title}</h2>
                <p class="hub__q">{e.question}</p>
                <p>{e.text}</p>
                <ul class="hub__learn" role="list">
                  {e.learn.map((l) => <li>{l}</li>)}
                </ul>
                <span class="hub__go">Lancer l’expérience <Icon name="arrow" /></span>
              </div>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section page hub-why" aria-labelledby="why-title">
    <div class="hub-why__grid">
      <h2 id="why-title">Pourquoi <em>expérimenter</em>&nbsp;?</h2>
      <div class="hub-why__text">
        <p class="lede">Lire qu’un chien « a besoin de flairer » ou qu’il « a besoin de distance » est une chose. Le voir, le manipuler, en est une autre.</p>
        <p>Ces expériences sont des illustrations pédagogiques, volontairement simplifiées. Elles ne remplacent pas l’observation de votre chien, ni un accompagnement personnalisé, mais elles aident à poser les bonnes questions.</p>
        <p><a class="link-arrow" href="/orientation/">Trouver par où commencer pour votre chien <Icon name="arrow" /></a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  .hub {
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .hub__head {
    display: grid;
    gap: var(--space-m);
    margin-bottom: var(--space-xl);
  }

  .hub__head h1 {
    font-size: var(--step-6);
    line-height: 0.9;
    max-width: 13ch;
  }

  .hub__head h1 :global(em) {
    color: var(--or);
  }

  .hub__head .lede {
    max-width: 50ch;
  }

  .hub__list {
    display: grid;
    gap: var(--space-l);
    padding: 0;
    list-style: none;
  }

  .hub__card {
    display: grid;
    gap: var(--space-l);
    padding: var(--space-m);
    border-radius: var(--radius-l);
    background: rgb(255 255 255 / 0.03);
    border: 1px solid rgb(255 255 255 / 0.08);
    color: var(--craie) !important;
    text-decoration: none;
    transition: background-color var(--dur) ease, border-color var(--dur) ease, transform var(--dur-slow) var(--ease-out);
  }

  .hub__card:hover {
    background: rgb(255 255 255 / 0.06);
    border-color: rgb(242 192 138 / 0.4);
  }

  @media (min-width: 56rem) {
    .hub__card {
      grid-template-columns: 1.1fr 1fr;
      align-items: center;
      padding: var(--space-l);
    }

    .hub__item:nth-child(even) .hub__preview {
      order: 2;
    }
  }

  .hub__preview {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-m);
    overflow: hidden;
    background: radial-gradient(70% 70% at 50% 40%, var(--sous-bois), var(--nuit-2));
  }

  .hub__text {
    display: grid;
    gap: var(--space-2xs);
    justify-items: start;
  }

  .hub__text h2 {
    font-size: var(--step-4);
  }

  .hub__q {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-1);
    color: var(--lagon);
  }

  .hub__text p:not(.hub__q) {
    color: var(--craie-douce);
    max-width: 46ch;
  }

  .hub__learn {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-block: var(--space-xs);
    padding: 0;
    list-style: none;
  }

  .hub__learn li {
    padding: 0.25rem 0.7rem;
    border-radius: var(--radius-pill);
    border: 1px solid rgb(255 255 255 / 0.18);
    font-size: var(--step--1);
    color: var(--craie-douce);
  }

  .hub__go {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    color: var(--or);
  }

  .hub__go :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    transition: transform var(--dur) var(--ease-out);
  }

  .hub__card:hover .hub__go :global(svg) {
    transform: translateX(0.3rem);
  }

  /* ---- Aperçu « flair » ---- */
  .pv-flair span {
    position: absolute;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: radial-gradient(circle, var(--or), transparent 70%);
    opacity: 0.8;
  }

  .pv-flair span:nth-child(3n) { background: radial-gradient(circle, var(--lagon), transparent 70%); }

  .pv-flair span:nth-child(1) { left: 12%; top: 30%; }
  .pv-flair span:nth-child(2) { left: 18%; top: 34%; }
  .pv-flair span:nth-child(3) { left: 24%; top: 31%; }
  .pv-flair span:nth-child(4) { left: 31%; top: 36%; }
  .pv-flair span:nth-child(5) { left: 38%; top: 33%; }
  .pv-flair span:nth-child(6) { left: 46%; top: 38%; }
  .pv-flair span:nth-child(7) { left: 55%; top: 35%; }
  .pv-flair span:nth-child(8) { left: 60%; top: 62%; }
  .pv-flair span:nth-child(9) { left: 66%; top: 66%; }
  .pv-flair span:nth-child(10) { left: 72%; top: 63%; }
  .pv-flair span:nth-child(11) { left: 79%; top: 68%; }
  .pv-flair span:nth-child(12) { left: 86%; top: 65%; }
  .pv-flair span:nth-child(13) { left: 20%; top: 72%; }
  .pv-flair span:nth-child(14) { left: 26%; top: 76%; }
  .pv-flair span:nth-child(15) { left: 33%; top: 73%; }
  .pv-flair span:nth-child(16) { left: 41%; top: 78%; }
  .pv-flair span:nth-child(17) { left: 70%; top: 18%; }
  .pv-flair span:nth-child(18) { left: 76%; top: 22%; }
  .pv-flair span:nth-child(19) { left: 83%; top: 19%; }
  .pv-flair span:nth-child(20) { left: 90%; top: 24%; }
  .pv-flair span:nth-child(n + 21) { left: 50%; top: 50%; opacity: 0.3; }

  @media (prefers-reduced-motion: no-preference) {
    .pv-flair span {
      animation: drift 3.2s ease-in-out infinite alternate;
      animation-delay: calc(var(--i, 0) * -0.5s);
    }

    .pv-flair__nose {
      animation: sniff 6s ease-in-out infinite;
    }

    .pv-distance__dot {
      animation: approach 6s ease-in-out infinite;
    }
  }

  @keyframes drift {
    to {
      transform: translate(1.2rem, -0.6rem) scale(1.3);
      opacity: 0.35;
    }
  }

  .pv-flair__nose {
    position: absolute;
    left: 30%;
    top: 40%;
    width: 1.6rem;
    height: 1.2rem;
    border-radius: 50%;
    background: var(--lagon);
    box-shadow: 0 0 0 0.6rem rgb(242 192 138 / 0.15), 0 0 0 1.4rem rgb(242 192 138 / 0.07);
  }

  @keyframes sniff {
    0%, 100% { transform: translate(0, 0); }
    30% { transform: translate(8rem, -0.5rem); }
    60% { transform: translate(5rem, 5rem); }
  }

  /* ---- Aperçu « distance » ---- */
  .pv-distance {
    position: absolute;
    inset: 30% 8% 30% 8%;
    display: flex;
    border-radius: var(--radius-pill);
    overflow: hidden;
  }

  .pv-distance__z--a { flex: 0 0 28%; background: rgb(233 180 156 / 0.5); }
  .pv-distance__z--b { flex: 0 0 26%; background: rgb(242 192 138 / 0.4); }
  .pv-distance__z--c { flex: 1; background: rgb(154 211 205 / 0.3); }

  .pv-distance__dot {
    position: absolute;
    top: 50%;
    left: 90%;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 50%;
    background: var(--craie);
    transform: translate(-50%, -50%);
    box-shadow: 0 0 1rem rgb(255 255 255 / 0.5);
  }

  @keyframes approach {
    0%, 100% { left: 92%; }
    50% { left: 10%; }
  }

  /* ---- Aperçu « signaux » ---- */
  .hub__preview :global(.pv-dog) {
    position: absolute;
    inset: 12% 14% 4%;
    width: 72%;
    height: auto;
  }

  .hub-why__grid {
    display: grid;
    gap: var(--space-l);
  }

  @media (min-width: 60rem) {
    .hub-why__grid {
      grid-template-columns: 5fr 7fr;
    }
  }

  .hub-why__text {
    display: grid;
    gap: var(--space-s);
    max-width: 60ch;
  }
</style>
