---
import Base from '~/layouts/Base.astro';
import SplitTitle from '~/components/SplitTitle.astro';
import StoryScroller from '~/components/StoryScroller.astro';
import type { StoryStep } from '~/lib/story';
import Plate from '~/components/Plate.astro';
import Fil from '~/components/Fil.astro';
import Faq from '~/components/Faq.astro';
import FirstMeeting from '~/components/FirstMeeting.astro';
import Draft from '~/components/Draft.astro';
import Icon from '~/components/Icon.astro';
import { site } from '~/config/site';
import { resolve } from '~/lib/fields';
import { joinFr } from '~/lib/wizard';

const purpose = resolve(site.firstMeeting.purpose);
const places = resolve(site.firstMeeting.places);
const phone = resolve(site.contact.phone);
const services = resolve(site.services);

const steps: StoryStep[] = [
  {
    scene: 'demande',
    title: 'Préparer sa demande',
    text: `Quelques questions à choix, via le parcours « Parlons de votre chien »${phone && !phone.draft ? ', ou un simple appel' : ''}. Pas besoin d’avoir les bons mots : décrire ce que vous vivez suffit.`,
    detail: 'Si vous le souhaitez, le centre de préparation vous aide à rassembler les informations utiles.',
  },
  {
    scene: 'echange',
    title: 'Le premier échange',
    text: `${purpose?.value ?? 'Un premier échange pour parler de la situation et faire connaissance avec votre chien.'}${places && !places.draft ? ` Il peut se dérouler ${joinFr(places.value, 'ou')}.` : ''}`,
    detail: 'C’est aussi le moment de poser toutes vos questions : méthodes, organisation, matériel.',
  },
  {
    scene: 'clarifier',
    title: 'Clarifier les besoins',
    text: 'Observer votre chien dans son environnement aide à comprendre ce qui se passe pour lui, et pour vous. On distingue ce qui fonctionne déjà de ce que vous aimeriez voir évoluer.',
    detail: 'Si une cause médicale est possible (douleur, changement brutal), un avis vétérinaire passe en premier.',
  },
  {
    scene: 'organiser',
    title: 'Organiser l’accompagnement',
    text: 'Des pistes adaptées à votre quotidien, expliquées simplement et réellement applicables, avec un rythme qui tient compte de votre temps disponible.',
  },
  {
    scene: 'suite',
    title: 'Envisager la suite',
    text: 'Vous faites le point régulièrement sur ce qui évolue. Vous restez libre de continuer, de faire une pause ou de vous arrêter.',
  },
];

const commitments = [
  { title: 'Pas de jugement', text: 'Beaucoup de familles se posent les mêmes questions. En parler, c’est déjà prendre soin de votre chien.' },
  { title: 'Pas de promesse miracle', text: 'Chaque chien progresse à son rythme. Personne ne peut garantir un résultat en un nombre fixe de séances.' },
  { title: 'Pas de diagnostic à distance', text: 'Le formulaire sert à préparer l’échange, pas à évaluer votre chien. Rien ne remplace une rencontre.' },
  { title: 'Le vétérinaire quand il le faut', text: 'Un changement brutal de comportement peut avoir une cause médicale, comme une douleur. Dans ce cas, un avis vétérinaire passe en premier.' },
];
---
<Base
  title="Le déroulement d’un accompagnement"
  description="Comment se déroule un accompagnement ToutouBien, étape par étape : préparer sa demande, le premier échange, clarifier les besoins, organiser la suite."
>
  <section class="dr-hero">
    <div class="page dr-hero__inner">
      <p class="eyebrow enter">Le déroulement</p>
      <SplitTitle as="h1" text="De la première question *à la suite du chemin*." now />
      <p class="lede enter" data-i="3">Chaque chien, chaque famille a son histoire. Voici, étape par étape, comment un accompagnement se construit à partir de la vôtre. Le déroulement s’adapte toujours à la situation.</p>
    </div>
  </section>

  <section class="section dr-story" aria-label="Les étapes de l’accompagnement">
    <div class="page">
      <StoryScroller steps={steps} />
    </div>
  </section>

  <!-- Chez vous ou dehors -->
  {
    places && (
      <section class="section places on-lin" aria-labelledby="places-title">
        <div class="page">
          <div class="places__head">
            <p class="eyebrow reveal">Là où vit votre chien</p>
            <h2 id="places-title" class="reveal">Chez vous <em>ou dehors</em></h2>
            <p class="lede reveal">
              Selon la situation, la rencontre peut se dérouler {joinFr(places.value, 'ou')}. Parce qu’un chien se comprend mieux là où les choses se passent.
            </p>
            {places.draft && <Draft label="Lieux à confirmer"><span /></Draft>}
          </div>
          <div class="places__grid">
            <figure class="place">
              <Plate id="accompagnement-domicile" sizes="(min-width: 60rem) 44vw, 92vw" />
              <figcaption>
                <Icon name="home" />
                <span><strong>À la maison.</strong> Le cadre de vie, les habitudes, les moments du quotidien.</span>
              </figcaption>
            </figure>
            <figure class="place place--offset">
              <Plate id="accompagnement-exterieur" sizes="(min-width: 60rem) 44vw, 92vw" />
              <figcaption>
                <Icon name="tree" />
                <span><strong>En extérieur.</strong> La balade, les rencontres, les situations qui se présentent.</span>
              </figcaption>
            </figure>
          </div>
        </div>
      </section>
    )
  }

  <FirstMeeting />

  <!-- Prestations : affichées uniquement lorsqu'elles sont confirmées -->
  {
    services && (
      <section class="section" aria-labelledby="services-title">
        <div class="page">
          <h2 id="services-title">Les formules</h2>
          {services.draft ? (
            <Draft label="Prestations à confirmer"><p>Liste des prestations à fournir.</p></Draft>
          ) : (
            <ul role="list" class="services">
              {services.value.map((s) => (
                <li>
                  <h3>{s.title}</h3>
                  <p>{s.summary}</p>
                  {s.price && <p class="services__price">{s.price}</p>}
                </li>
              ))}
            </ul>
          )}
        </div>
      </section>
    )
  }
  <Draft label="Prestations et tarifs à fournir">
    <div class="page"><p>Aucune prestation détaillée n’est encore confirmée : cette section restera masquée en production tant que la liste n’est pas validée (voir docs/CONTENT-VALIDATION.md).</p></div>
  </Draft>

  <!-- Engagements -->
  <section class="section commitments on-dark" aria-labelledby="commitments-title">
    <Fil variant="vague" class="commitments__fil" />
    <div class="page">
      <p class="eyebrow reveal">L’état d’esprit</p>
      <h2 id="commitments-title" class="reveal">Ce que vous <em>pouvez attendre</em></h2>
      <ul class="commitments__list" role="list">
        {
          commitments.map((c, i) => (
            <li class="reveal" data-i={i}>
              <h3>{c.title}</h3>
              <p>{c.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Faq scope="accompagnement" />
</Base>

<style>
  .dr-hero {
    padding-block: var(--space-xl) 0;
  }

  .dr-hero__inner {
    display: grid;
    gap: var(--space-m);
  }

  .dr-hero h1 {
    max-width: 15ch;
    font-size: var(--step-6);
    line-height: 0.9;
  }

  .dr-hero h1 :global(em) {
    color: var(--accent);
  }

  .dr-hero .lede {
    max-width: 56ch;
  }

  .places__head {
    display: grid;
    gap: var(--space-s);
    max-width: 46rem;
    margin-bottom: var(--space-xl);
  }

  .places__grid {
    display: grid;
    gap: var(--space-l);
  }

  @media (min-width: 60rem) {
    .places__grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
      gap: var(--space-xl);
    }

    .place--offset {
      margin-top: var(--space-2xl);
    }
  }

  .place figcaption {
    display: flex;
    gap: var(--space-s);
    align-items: flex-start;
    margin-top: var(--space-s);
    max-width: 40ch;
    color: var(--encre-douce);
  }

  .place figcaption :global(svg) {
    flex: none;
    width: 1.6rem;
    height: 1.6rem;
    color: var(--accent);
  }

  .place strong {
    color: var(--encre);
  }

  .services {
    display: grid;
    gap: var(--space-l);
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    padding: 0;
    margin-top: var(--space-l);
    list-style: none;
  }

  .services__price {
    margin-top: var(--space-xs);
    font-weight: 600;
  }

  .commitments {
    overflow: hidden;
  }

  .commitments__fil {
    position: absolute;
    left: 0;
    bottom: var(--space-l);
    width: 100%;
    height: 4rem;
    color: var(--lagon);
    opacity: 0.3;
  }

  .commitments h2 {
    margin-top: var(--space-s);
    max-width: 16ch;
  }

  .commitments__list {
    display: grid;
    gap: var(--space-l) var(--space-xl);
    margin-top: var(--space-xl);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .commitments__list {
      grid-template-columns: 1fr 1fr;
    }
  }

  .commitments__list li {
    padding-top: var(--space-m);
    border-top: 1px solid rgb(255 255 255 / 0.18);
  }

  .commitments__list h3 {
    margin-bottom: var(--space-2xs);
    color: var(--lagon);
  }

  .commitments__list p {
    color: var(--craie-douce);
    max-width: 44ch;
  }
</style>
