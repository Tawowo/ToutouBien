---
/** Petit jeu d'icônes au trait, dessiné pour ToutouBien. Décoratif par défaut. */
interface Props {
  name: 'arrow' | 'arrow-left' | 'menu' | 'close' | 'phone' | 'mail' | 'check' | 'edit' | 'pin' | 'home' | 'tree' | 'chat';
  class?: string;
  label?: string;
}
const { name, class: className, label } = Astro.props;
const paths: Record<Props['name'], string> = {
  arrow: '<path d="M4 12h15M13 6l6 6-6 6"/>',
  'arrow-left': '<path d="M20 12H5M11 6l-6 6 6 6"/>',
  menu: '<path d="M3 8h18M3 16h12"/>',
  close: '<path d="M6 6l12 12M18 6L6 18"/>',
  phone: '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>',
  check: '<path d="M4 12.5l5 5L20 6.5"/>',
  edit: '<path d="M4 20h4L19 9l-4-4L4 16v4zM13.5 6.5l4 4"/>',
  pin: '<path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
  home: '<path d="M3 11l9-7 9 7M5 9.5V20h14V9.5"/><path d="M10 20v-5h4v5"/>',
  tree: '<path d="M12 21v-6M12 15c-4 0-6-2.5-6-5.5S9 3 12 3s6 3.5 6 6.5S16 15 12 15z"/><path d="M4 21h16"/>',
  chat: '<path d="M4 5h16v11H9l-5 4V5z"/>',
};
---
<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={paths[name]}
/>
