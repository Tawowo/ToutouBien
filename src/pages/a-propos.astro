---
import Base from '~/layouts/Base.astro';
import Plate from '~/components/Plate.astro';
import Fil from '~/components/Fil.astro';
import Draft from '~/components/Draft.astro';
import Icon from '~/components/Icon.astro';
import Emblem from '~/assets/brand/emblem.svg';
import { site } from '~/config/site';
import { resolve, draftsVisible } from '~/lib/fields';
import { photoFor } from '~/content/photos';

const e = site.educator;
const name = resolve(e.displayName);
const role = resolve(e.role);
const intro = resolve(e.intro);
const story = resolve(e.story);
const vision = resolve(e.vision);
const methods = resolve(e.methods);
const values = resolve(e.values);
const qualifications = resolve(e.qualifications);
const experience = resolve(e.experience);
const showDrafts = draftsVisible();
const hasWorkPhoto = Boolean(photoFor('apropos-atelier'));
const publicName = name && !name.draft ? name.value : undefined;
---
<Base
  title="À propos"
  description="Qui se cache derrière ToutouBien : une éducatrice qui accompagne les familles et leur chien, chez elles ou en extérieur, pour une relation qui fait du bien au quotidien."
>
  <section class="about-intro">
    <div class="page about-intro__grid">
      <div class="about-intro__text">
        <p class="eyebrow enter" data-i="0">À propos</p>
        <h1 class="enter" data-i="1">Qui vous <em>accompagne</em></h1>
        {publicName && <p class="about-intro__name enter" data-i="2">{publicName}{role && !role.draft ? `, ${role.value.toLowerCase()}` : ''}</p>}
        {name?.draft && <Draft label="Nom et titre à confirmer"><p class="about-intro__name">{name.value}{role ? `, ${role.value.toLowerCase()}` : ''}</p></Draft>}
        {
          intro && !intro.draft ? (
            <p class="lede enter" data-i="3">{intro.value}</p>
          ) : (
            <p class="lede enter" data-i="3">
              ToutouBien accompagne les propriétaires de chiens dans leur quotidien. Son éducatrice se déplace pour rencontrer les familles et leur chien là où ils vivent&nbsp;: chez eux, ou en extérieur.
            </p>
          )
        }
        {showDrafts && !intro && <Draft label="Présentation à fournir"><p>{e.intro.note}</p></Draft>}
      </div>
      <Plate id="educatrice-portrait" class="about-intro__plate" shape="arch" priority sizes="(min-width: 60rem) 36vw, 86vw" />
    </div>
  </section>

  <!-- Le sens du logo : un fait vérifiable, le logo fourni -->
  <section class="section emblem-story on-dark" aria-labelledby="emblem-title">
    <div class="page emblem-story__grid">
      <div class="emblem-story__art reveal" aria-hidden="true">
        <Emblem class="emblem-story__emblem" />
      </div>
      <div class="emblem-story__text">
        <p class="eyebrow reveal">Une histoire de regard</p>
        <h2 id="emblem-title" class="reveal">Face à face, <em>à la même hauteur</em></h2>
        <p class="lede reveal">
          Une femme et un chien qui se regardent, réunis dans un cœur. Le logo de ToutouBien résume l’idée qui guide l’accompagnement&nbsp;: une relation se construit dans les deux sens, avec attention et bienveillance.
        </p>
        <p class="emblem-story__tagline reveal">«&nbsp;{site.tagline.value}&nbsp;»</p>
      </div>
    </div>
  </section>

  <!-- Parcours, vision, méthodes : affichés lorsque fournis -->
  {
    (story || vision || methods || experience) && (
      <section class="section about-story" aria-labelledby="story-title">
        <div class="page about-story__grid">
          <h2 id="story-title" class="reveal">Son <em>parcours</em></h2>
          <div class="about-story__body stack">
            {story && (story.draft ? <Draft>{story.value.map((p) => <p>{p}</p>)}</Draft> : story.value.map((p) => <p class="reveal">{p}</p>))}
            {experience && (experience.draft ? <Draft><p>{experience.value}</p></Draft> : <p class="reveal">{experience.value}</p>)}
            {vision && (
              <div class="about-story__quote reveal">
                <h3>Sa vision</h3>
                {vision.draft ? <Draft><p>{vision.value}</p></Draft> : <p>{vision.value}</p>}
              </div>
            )}
            {methods && (
              <div class="reveal">
                <h3>Sa façon de travailler</h3>
                {methods.draft ? <Draft><p>{methods.value}</p></Draft> : <p>{methods.value}</p>}
              </div>
            )}
          </div>
        </div>
      </section>
    )
  }

  {
    values && !values.draft && (
      <section class="section values on-lin" aria-labelledby="values-title">
        <div class="page">
          <h2 id="values-title" class="reveal">Ce qui <em>compte</em></h2>
          <ul class="values__list" role="list">
            {values.value.map((v) => (
              <li class="reveal">
                <h3>{v.title}</h3>
                <p>{v.text}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    qualifications && !qualifications.draft && (
      <section class="section section--tight" aria-labelledby="quals-title">
        <div class="page">
          <h2 id="quals-title" class="reveal">Formations et <em>certifications</em></h2>
          <ul class="quals" role="list">
            {qualifications.value.map((q) => <li class="reveal"><Icon name="check" />{q}</li>)}
          </ul>
        </div>
      </section>
    )
  }

  {hasWorkPhoto && (
    <section class="section section--tight">
      <div class="page"><Plate id="apropos-atelier" sizes="92vw" /></div>
    </section>
  )}

  <Draft label="Contenus à fournir pour cette page">
    <div class="page about-todo">
      <p><strong>Ces éléments s’afficheront automatiquement dès qu’ils seront renseignés dans src/config/site.ts&nbsp;:</strong></p>
      <ul>
        {[e.story, e.vision, e.methods, e.values, e.qualifications, e.experience].filter((f) => f.status === 'missing').map((f) => <li>{f.note}</li>)}
        {!hasWorkPhoto && <li>Photo authentique de l’éducatrice en situation (emplacement « apropos-atelier »).</li>}
      </ul>
    </div>
  </Draft>

  <section class="section about-next" aria-labelledby="about-next-title">
    <Fil variant="traversee" class="about-next__fil" />
    <div class="page about-next__grid">
      <h2 id="about-next-title" class="reveal">Le mieux, <em>c’est encore de se rencontrer.</em></h2>
      <div class="about-next__links reveal">
        <a class="link-arrow" href="/accompagnement/">Comment se passe l’accompagnement <Icon name="arrow" /></a>
        <a class="link-arrow" href="/contact/">Toutes les façons de nous joindre <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

</Base>

<style>
  .about-intro {
    padding-block: var(--space-xl);
  }

  .about-intro__grid {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  .about-intro__text {
    display: grid;
    gap: var(--space-m);
  }

  .about-intro h1 {
    font-size: var(--step-6);
    line-height: 0.98;
  }

  .about-intro__name {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-2);
    color: var(--sarcelle);
  }

  .about-intro .lede {
    max-width: 46ch;
  }

  .about-intro__plate {
    width: min(100%, 28rem);
    justify-self: center;
  }

  @media (min-width: 60rem) {
    .about-intro__grid {
      grid-template-columns: 7fr 5fr;
    }
  }

  .emblem-story__grid {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  .emblem-story__art {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--nuit-2);
    width: min(100%, 30rem);
    justify-self: center;
  }

  .emblem-story__emblem {
    width: 72%;
    height: auto;
    color: var(--lagon);
  }

  .emblem-story__text {
    display: grid;
    gap: var(--space-m);
  }

  .emblem-story__text h2 em {
    color: var(--lagon);
  }

  .emblem-story__tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-2);
    color: var(--lagon-clair);
  }

  @media (min-width: 60rem) {
    .emblem-story__grid {
      grid-template-columns: 5fr 6fr;
      gap: var(--space-2xl);
    }
  }

  .about-story__grid {
    display: grid;
    gap: var(--space-l);
  }

  @media (min-width: 60rem) {
    .about-story__grid {
      grid-template-columns: 4fr 7fr;
    }
  }

  .about-story__body {
    --flow: var(--space-m);
    max-width: var(--measure);
    font-size: var(--step-1);
  }

  .about-story__quote {
    padding-left: var(--space-m);
    border-left: 2px solid var(--accent);
    font-family: var(--font-display);
    font-style: italic;
  }

  .values__list {
    display: grid;
    gap: var(--space-l);
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    margin-top: var(--space-l);
    padding: 0;
    list-style: none;
  }

  .quals {
    display: grid;
    gap: var(--space-s);
    margin-top: var(--space-m);
    padding: 0;
    list-style: none;
  }

  .quals li {
    display: flex;
    gap: var(--space-s);
    align-items: center;
  }

  .quals :global(svg) {
    width: 1.3rem;
    height: 1.3rem;
    color: var(--sarcelle);
  }

  .about-todo ul {
    margin-top: var(--space-s);
  }

  .about-next {
    overflow: hidden;
  }

  .about-next__fil {
    position: absolute;
    inset: auto 0 10% 0;
    width: 100%;
    height: 7rem;
    color: var(--accent);
    opacity: 0.4;
  }

  .about-next__grid {
    position: relative;
    display: grid;
    gap: var(--space-l);
    align-items: end;
  }

  .about-next h2 {
    max-width: 18ch;
  }

  .about-next__links {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
  }

  @media (min-width: 60rem) {
    .about-next__grid {
      grid-template-columns: 3fr 2fr;
    }
  }
</style>
