---
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import { INSIGHTS, QUESTIONS } from '~/lib/orientation';
import Photo from '~/components/Photo.astro';
import { ACC_PHOTOS } from '~/lib/situation-photos';
// Une photo par réponse possible : chaque choix produit une réaction visible.
const ANSWER_PHOTO: Record<string, string> = {
  'chiot-a-venir': 'chiot-portee', 'chiot-arrive': 'chiot-exploration', adopte: 'portrait-berger-australien', installe: 'maison-golden', senior: 'senior-labrador',
  promenade: 'balade-duo-laisses', rappel: 'rappel-course', solitude: 'attente-porte', visites: 'jeu-deux-chiens-blancs', congeneres: 'rencontre-huskies', inquietude: 'observe-levrier', mordille: 'chiot-mordille', comprendre: 'observe-duo',
  curieux: 'observe-profil', perplexe: 'portrait-pre', fatigue: 'maison-sieste', inquiet: 'senior-hiver',
  lire: 'nature-soleil', preparer: 'lien-laisse-golden', parler: 'lien-pelouse',
};
import { SITUATIONS } from '~/lib/decodeur';
import { ACCOMPAGNEMENTS } from '~/content/accompagnements';
import { EXPERIENCES } from '~/content/explorer';
import { visibleArticles, readingMinutes } from '~/lib/articles';

const articles = (await visibleArticles()).map((a) => ({ id: a.id, title: a.data.title, minutes: readingMinutes(a.body) }));
const data = {
  articles,
  accompagnements: ACCOMPAGNEMENTS.map((a) => ({ slug: a.slug, label: a.label, short: a.short })),
  explorers: EXPERIENCES.map((e) => ({ id: e.id, title: e.title, question: e.question, href: e.href })),
  dossiers: SITUATIONS.map((d) => ({ id: d.id, title: d.title, voice: d.voice })),
};
// Constellation du parcours : une étoile par question, l'arrivée, et une étoile satellite par préoccupation.
const STARS = [
  { x: 46, y: 196, word: 'Situation' },
  { x: 118, y: 92, word: 'Préoccupations' },
  { x: 204, y: 160, word: 'Ressenti' },
  { x: 262, y: 70, word: 'Envie' },
];
const END = { x: 290, y: 214, word: 'Vos pistes' };
const concernCount = QUESTIONS[1].options.length;
const SAT = Array.from({ length: concernCount }, (_, i) => {
  const a = (i / concernCount) * Math.PI * 2 - Math.PI / 2;
  return { x: STARS[1]!.x + Math.cos(a) * 34, y: STARS[1]!.y + Math.sin(a) * 34 };
});
const POINTS = [...STARS, END];
const steps = QUESTIONS.length;
---
<Base
  title="Où en êtes-vous avec votre chien ?"
  description="Quatre questions pour savoir par où commencer : un récapitulatif, l’accompagnement le plus proche de votre situation, des lectures et une suite possible. Aucun diagnostic, aucune donnée enregistrée."
  headerTheme="dark"
  quietFooter
>
  <section class="or on-dark grain-dark" aria-labelledby="or-title" data-orientation data-payload={JSON.stringify(data)}>
    <div class="page or__inner">
      <header class="or__head">
        <p class="eyebrow">Parcours d’orientation</p>
        <h1 id="or-title" class="or__title">Où en êtes-vous <em>avec votre chien</em>&nbsp;?</h1>
        <p class="or__intro">Quatre questions, deux minutes. Vous obtenez un récapitulatif et des pistes pour la suite. Ce n’est pas un diagnostic, et rien n’est enregistré ni envoyé.</p>
      </header>

      <div class="or__stage">
      <figure class="or__sky" aria-hidden="true" data-or-sky>
        <svg viewBox="0 0 320 250" focusable="false">
          {POINTS.slice(1).map((p, i) => (
            <line x1={POINTS[i]!.x} y1={POINTS[i]!.y} x2={p.x} y2={p.y} pathLength="1" class="or__ray" data-ray={i} />
          ))}
          {SAT.map((p, i) => (
            <g class="or__sat" data-sat={i}>
              <line x1={STARS[1]!.x} y1={STARS[1]!.y} x2={p.x} y2={p.y} pathLength="1" />
              <circle cx={p.x} cy={p.y} r="2.6" />
            </g>
          ))}
          {POINTS.map((p, i) => (
            <g class:list={['or__star', i === POINTS.length - 1 && 'or__star--end']} data-star={i}>
              <circle cx={p.x} cy={p.y} r="16" class="or__halo" />
              <circle cx={p.x} cy={p.y} r={i === POINTS.length - 1 ? 6 : 4.5} class="or__core" />
              <text x={p.x} y={p.y + (i === 1 ? -46 : p.y > 150 ? 30 : -22)} text-anchor="middle">{p.word}</text>
            </g>
          ))}
        </svg>
        <figcaption class="or__sky-count" data-or-count></figcaption>
        <div class="or__pics" data-or-pics>
          {Object.entries(ANSWER_PHOTO).map(([id, ph]) => (
            <span class="or__pic" data-or-pic={id}><Photo id={ph} shape="round" credit="none" alt="" sizes="12rem" /></span>
          ))}
        </div>
      </figure>

      <div class="or__main">
      <p class="or__preset" data-or-preset hidden></p>
      <form class="or__form" data-or-form novalidate>
        {
          QUESTIONS.map((q, i) => (
            <fieldset class:list={['or__step', i === 0 && 'is-current']} data-step={i} data-key={q.key} data-multiple={q.multiple ? 'true' : undefined}>
              <legend class="or__q">
                <span class="label">Question {i + 1} sur {steps}</span>
                <span class="or__q-text" tabindex="-1" data-step-title>{q.title}</span>
              </legend>
              <p class="or__help">{q.help}</p>
              <div class="or__options">
                {q.options.map((o) => (
                  <label class="or__opt">
                    <input type={q.multiple ? 'checkbox' : 'radio'} name={q.key} value={o.id} data-insight={INSIGHTS[o.id]} />
                    <span class="or__opt-body">
                      <span class="or__opt-label">{o.label}</span>
                      {'hint' in o && o.hint && <span class="or__opt-hint">{o.hint}</span>}
                    </span>
                    <span class="or__opt-mark" aria-hidden="true"><Icon name="check" /></span>
                  </label>
                ))}
              </div>
              <p class="or__insight" aria-live="polite" data-insight></p>
              <p class="or__error" role="alert" data-step-error></p>
            </fieldset>
          ))
        }

        <div class="or__nav" data-or-nav>
          <button type="button" class="btn btn--ghost" data-or-back hidden><Icon name="arrow-left" /> Retour</button>
          <button type="submit" class="btn btn--clair" data-or-next><span data-or-next-label>Continuer</span> <Icon name="arrow" class="btn__arrow" /></button>
        </div>
      </form>

      <section class="or__result" data-or-result hidden aria-labelledby="or-result-title">
        <h2 id="or-result-title" class="or__result-title" tabindex="-1">Votre <em>récapitulatif</em></h2>
        <div class="or__care notice" role="note" data-or-care hidden>
          Si votre chien semble souffrir, a changé de comportement brusquement ou si la sécurité de quelqu’un est en jeu, consultez d’abord votre vétérinaire. Une douleur ou un problème de santé peuvent expliquer bien des comportements.
        </div>
        <ul class="or__summary" role="list" data-or-summary></ul>
        <div class="or__cards">
          <a class="or__card or__card--main" data-or-acc href="/accompagnements/">
            <span class="or__card-photos">
              {Object.entries(ACC_PHOTOS).map(([slug, ph]) => (
                <span class="or__card-photo" data-or-photo={slug} hidden>
                  <Photo id={ph.card} shape="soft" ratio="16-9" credit="none" alt="" sizes="(min-width: 60rem) 30vw, 90vw" />
                </span>
              ))}
            </span>
            <span class="label">L’accompagnement le plus proche</span>
            <strong data-or-acc-label></strong>
            <span data-or-acc-short></span>
            <Icon name="arrow" class="or__card-arrow" />
          </a>
          <a class="or__card" data-or-exp href="/explorer/">
            <span class="label">Une expérience à essayer</span>
            <strong data-or-exp-label></strong>
            <span data-or-exp-question></span>
            <Icon name="arrow" class="or__card-arrow" />
          </a>
        </div>
        <div class="or__dossiers" data-or-dossiers hidden>
          <h3>Les dossiers liés à vos réponses</h3>
          <ul role="list" data-or-dossiers-list></ul>
        </div>
        <div class="or__reads" data-or-reads hidden>
          <h3>À lire pour commencer</h3>
          <ul role="list" data-or-reads-list></ul>
        </div>
        <div class="or__next">
          <a class="btn btn--clair" data-or-primary href="/parlons-de-votre-chien/"><span data-or-primary-label>En parler</span> <Icon name="arrow" class="btn__arrow" /></a>
          <button type="button" class="btn btn--ghost" data-or-edit>Modifier mes réponses</button>
          <button type="button" class="or__restart" data-or-restart>Recommencer</button>
        </div>
        <p class="or__privacy">Vos réponses restent dans cette page et disparaissent dès que vous la quittez. Si vous choisissez d’en parler, seul un court récapitulatif est proposé dans le formulaire, que vous pouvez modifier ou effacer.</p>
      </section>
      </div>
      </div>

      <noscript>
        <p class="or__noscript">Ce parcours a besoin de JavaScript. Vous pouvez aussi parcourir directement <a href="/accompagnements/">les accompagnements</a> ou <a href="/parlons-de-votre-chien/">nous écrire</a>.</p>
      </noscript>
    </div>
  </section>
</Base>

<script>
  import { initOrientation } from '~/scripts/orientation';
  initOrientation();
</script>

<style>
  .or {
    min-height: calc(100svh - 4.75rem);
    padding-block: var(--space-xl);
  }

  .or__inner {
    display: grid;
    gap: var(--space-l);
    max-width: 74rem;
  }

  .or__head {
    display: grid;
    gap: var(--space-s);
  }

  .or__title {
    font-size: var(--step-5);
    line-height: 0.95;
    max-width: 14ch;
  }

  .or__title em {
    color: var(--lueur);
  }

  .or__intro {
    max-width: 52ch;
    color: var(--craie-douce);
  }

  /* La constellation du parcours : chaque réponse allume une étoile. */
  .or__stage {
    display: grid;
    gap: var(--space-l);
    align-items: start;
  }

  @media (min-width: 60rem) {
    .or__stage {
      grid-template-columns: 17rem minmax(0, 1fr);
      gap: var(--space-xl);
    }

    .or__sky {
      position: sticky;
      top: calc(var(--header-h, 5rem) + var(--space-m));
    }
  }

  .or__sky {
    display: none;
    margin: 0;
    scroll-margin-top: calc(var(--header-h, 5rem) + var(--space-s));
  }

  :global(.js) .or__sky {
    display: grid;
    gap: var(--space-xs);
    justify-items: center;
  }

  .or__sky svg {
    width: 100%;
    max-width: 17rem;
    overflow: visible;
  }

  @media (max-width: 59.99rem) {
    .or__sky svg {
      max-width: 11rem;
    }

    .or__stage {
      gap: var(--space-s);
    }
  }

  .or__ray,
  .or__sat line {
    stroke: var(--lagon);
    stroke-width: 1.2;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 900ms var(--ease-out);
  }

  .or__ray {
    filter: drop-shadow(0 0 4px rgb(154 211 205 / 0.7));
  }

  .or__ray.is-on,
  .or__sat.is-on line {
    stroke-dashoffset: 0;
  }

  .or__sat line {
    stroke-width: 0.8;
    opacity: 0.7;
  }

  .or__sat circle {
    fill: var(--lueur);
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0.2);
    transition: opacity 400ms ease 250ms, transform 600ms var(--ease-out) 250ms;
  }

  .or__sat.is-on circle {
    opacity: 1;
    transform: none;
  }

  .or__halo {
    fill: rgb(154 211 205 / 0.08);
    transform-box: fill-box;
    transform-origin: center;
    transition: fill 500ms ease, transform 700ms var(--ease-out);
  }

  .or__core {
    fill: rgb(154 211 205 / 0.28);
    transition: fill 400ms ease;
  }

  .or__star text {
    fill: var(--craie-douce);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.55;
    transition: opacity 400ms ease, fill 400ms ease;
  }

  .or__star.is-current .or__halo {
    fill: rgb(154 211 205 / 0.18);
    transform: scale(1.25);
  }

  .or__star.is-current text,
  .or__star.is-on text {
    opacity: 1;
    fill: var(--craie);
  }

  .or__star.is-on .or__core {
    fill: var(--lueur);
  }

  .or__star.is-on .or__halo {
    fill: rgb(154 211 205 / 0.22);
  }

  .or__star--end.is-on .or__halo {
    fill: rgb(154 211 205 / 0.35);
    transform: scale(1.6);
  }

  .or__pics {
    position: relative;
    width: 9rem;
    aspect-ratio: 1;
    margin-top: var(--space-s);
  }

  .or__pic {
    position: absolute;
    inset: 0;
    opacity: 0;
    clip-path: circle(0% at 50% 50%);
    transition: clip-path 700ms cubic-bezier(0.16, 1, 0.3, 1), opacity 300ms ease;
  }

  .or__pic.is-on {
    opacity: 1;
    clip-path: circle(50% at 50% 50%);
  }

  .or__pic :global(.ph) {
    padding: 0.3rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.12);
    box-shadow: 0 0 0 2px var(--lagon);
  }

  @media (max-width: 59.99rem) {
    .or__pics {
      width: 5.5rem;
      position: absolute;
      right: 0;
      top: 0;
      margin: 0;
    }

    .or__sky {
      position: relative;
    }
  }

  .or__sky-count {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--lagon);
  }

  @media (prefers-reduced-motion: no-preference) {
    .or__star.is-current .or__halo {
      animation: or-breathe 2.8s ease-in-out infinite;
    }
  }

  @keyframes or-breathe {
    50% {
      transform: scale(1.5);
    }
  }

  .or__main {
    display: grid;
    gap: var(--space-m);
    min-width: 0;
  }

  .or__preset {
    padding: 0.6rem 1rem;
    border-radius: var(--radius-pill);
    border: 1px solid rgb(154 211 205 / 0.35);
    color: var(--lagon);
    font-size: var(--step--1);
    justify-self: start;
  }

  .or__preset[hidden] {
    display: none;
  }

  .or__insight {
    position: relative;
    padding-left: 1.6rem;
    color: var(--craie);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-1);
    line-height: 1.3;
  }

  .or__insight:empty {
    display: none;
  }

  .or__insight::before {
    content: '';
    position: absolute;
    left: 0.2rem;
    top: 0.55em;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--lueur);
    box-shadow: 0 0 10px rgb(154 211 205 / 0.9);
  }

  @media (prefers-reduced-motion: no-preference) {
    .or__insight.is-new {
      animation: or-in 600ms var(--ease-out) both;
    }
  }

  .or__dossiers h3,
  .or__reads h3 {
    margin-bottom: var(--space-s);
  }

  .or__dossiers :global(ul) {
    display: grid;
    gap: var(--space-s);
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    padding: 0;
    list-style: none;
  }

  .or__dossiers :global(a) {
    display: grid;
    gap: 0.25rem;
    height: 100%;
    padding: var(--space-m);
    border-radius: var(--radius-m);
    border: 1px solid rgb(154 211 205 / 0.25);
    background: rgb(255 255 255 / 0.03);
    color: var(--craie) !important;
    text-decoration: none;
    transition: border-color var(--dur) ease, transform var(--dur) var(--ease-out);
  }

  .or__dossiers :global(a:hover) {
    border-color: var(--lagon);
    transform: translateY(-2px);
  }

  .or__dossiers :global(a strong) {
    line-height: 1.1;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-1);
  }

  .or__dossiers :global(a small) {
    color: var(--craie-douce);
    font-style: italic;
  }

  :global(.no-js) .or__nav {
    display: none;
  }

  .or__form {
    display: grid;
    gap: var(--space-l);
  }

  .or__step {
    display: grid;
    gap: var(--space-s);
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  :global(.js) .or__step:not(.is-current) {
    display: none;
  }

  .is-live .or__step.is-current {
    animation: or-in 600ms var(--ease-out) both;
  }

  @keyframes or-in {
    from {
      opacity: 0;
      transform: translateY(1.2rem);
    }
  }

  .or__q {
    display: grid;
    gap: var(--space-xs);
    padding: 0;
  }

  .or__q-text {
    font-family: var(--font-display);
    font-size: var(--step-4);
    line-height: 1;
    color: var(--craie);
    outline: none;
  }

  .or__help {
    color: var(--craie-douce);
    font-size: var(--step--1);
  }

  .or__options {
    display: grid;
    gap: 0.6rem;
    margin-top: var(--space-s);
  }

  @media (min-width: 48rem) {
    .or__options {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .or__opt {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-s);
    align-items: center;
    padding: 1rem 1.1rem;
    border-radius: var(--radius-m);
    border: 1.5px solid rgb(255 255 255 / 0.16);
    background: rgb(255 255 255 / 0.03);
    cursor: pointer;
    transition: border-color var(--dur) ease, background-color var(--dur) ease, transform var(--dur) var(--ease-out);
  }

  .or__opt:hover {
    border-color: rgb(255 255 255 / 0.4);
    transform: translateY(-2px);
  }

  .or__opt input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }

  .or__opt-body {
    display: grid;
    gap: 0.15rem;
  }

  .or__opt-label {
    font-weight: 600;
    color: var(--craie);
  }

  .or__opt-hint {
    font-size: var(--step--1);
    color: var(--craie-douce);
  }

  .or__opt-mark {
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    border: 1.5px solid rgb(255 255 255 / 0.3);
    color: transparent;
    transition: background-color var(--dur) ease, color var(--dur) ease, transform var(--dur) var(--ease-out);
  }

  .or__opt-mark :global(svg) {
    width: 0.95rem;
    height: 0.95rem;
  }

  .or__opt:has(input:checked) {
    border-color: var(--lueur);
    background: color-mix(in oklab, var(--lueur) 14%, transparent);
  }

  .or__opt:has(input:checked) .or__opt-mark {
    background: var(--lueur);
    border-color: var(--lueur);
    color: var(--nuit);
    transform: scale(1.1);
  }

  .or__opt:has(input:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  .or__error {
    min-height: 1.4em;
    color: #ffb4a1;
    font-weight: 600;
  }

  .or__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-s);
  }

  .or__nav[hidden] {
    display: none;
  }

  .btn :global(svg:not(.btn__arrow)) {
    width: 1.1rem;
    height: 1.1rem;
  }

  /* Résultat */
  .or__result {
    display: grid;
    gap: var(--space-m);
    animation: or-in 700ms var(--ease-out) both;
  }

  .or__result[hidden] {
    display: none;
  }

  .or__result-title {
    font-size: var(--step-4);
    outline: none;
  }

  .or__result-title em {
    color: var(--lagon);
  }

  .or__care {
    background: color-mix(in oklab, var(--accent) 30%, var(--nuit));
    color: var(--craie);
    border: 0;
  }

  .or__summary {
    display: grid;
    gap: 0.4rem;
    padding: 0;
    list-style: none;
    font-size: var(--step-1);
    color: var(--craie-douce);
  }

  .or__cards {
    display: grid;
    gap: var(--space-s);
  }

  @media (min-width: 48rem) {
    .or__cards {
      grid-template-columns: 3fr 2fr;
    }
  }

  .or__card {
    position: relative;
    display: grid;
    gap: 0.4rem;
    align-content: start;
    padding: var(--space-m) var(--space-l) var(--space-m) var(--space-m);
    border-radius: var(--radius-l);
    background: rgb(255 255 255 / 0.06);
    color: var(--craie) !important;
    text-decoration: none;
    transition: transform var(--dur) var(--ease-out), background-color var(--dur) ease;
  }

  .or__card:hover {
    transform: translateY(-3px);
    background: rgb(255 255 255 / 0.1);
  }

  .or__card-photos {
    display: block;
    margin: -0.4rem -0.4rem 0.3rem;
  }

  .or__card-photo[hidden] {
    display: none;
  }

  .or__card--main {
    background: var(--lagon);
    color: var(--nuit) !important;
  }

  .or__card--main:hover {
    background: color-mix(in oklab, var(--lagon) 88%, white);
  }

  .or__card strong {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-3);
