---
import Icon from './Icon.astro';
import Draft from './Draft.astro';
import Fil from './Fil.astro';
import Emblem from '~/assets/brand/emblem.svg';
import Signature from '~/assets/brand/wordmark-signature.svg';
import { CTA_NAV, LEGAL_NAV, NAV_GROUPS } from '~/config/navigation';
import { site } from '~/config/site';
import { publicValue, resolve } from '~/lib/fields';
import { visibleArticles } from '~/lib/articles';

interface Props {
  /** Masque le grand appel final (pages qui sont déjà le formulaire). */
  quiet?: boolean;
}
const { quiet = false } = Astro.props;
const hasArticles = (await visibleArticles()).length > 0;
const groups = NAV_GROUPS.map((g) => ({ ...g, items: g.items.filter((i) => i.href !== '/ressources/' || hasArticles) }));
const phone = resolve(site.contact.phone);
const phoneE164 = publicValue(site.contact.phoneE164);
const email = resolve(site.contact.email);
const area = resolve(site.serviceArea.label);
const social = resolve(site.social);
const year = new Date().getFullYear();
---
<footer class="site-footer on-dark grain-dark">
  {
    !quiet && (
      <div class="footer-call page">
        <p class="label">Le premier pas</p>
        <a class="footer-call__link" href={CTA_NAV.href}>
          <span class="footer-call__text">
            On en <em>parle</em>&nbsp;?
          </span>
          <span class="footer-call__icon" aria-hidden="true">
            <Icon name="arrow" />
          </span>
          <span class="sr-only">{CTA_NAV.label}</span>
        </a>
        <Fil variant="traversee" class="footer-call__fil" />
      </div>
    )
  }

  <div class="page site-footer__grid">
    <div class="site-footer__brand">
      <a href="/" class="footer-logo" aria-label="ToutouBien, retour à l’accueil">
        <Emblem class="footer-logo__emblem" aria-hidden="true" />
        <Signature class="footer-logo__word" aria-hidden="true" />
      </a>
      <ul role="list" class="site-footer__contact">
        {phone && !phone.draft && <li><Icon name="phone" /><a href={`tel:${phoneE164 ?? phone.value.replace(/\s/g, '')}`}>{phone.value}</a></li>}
        {email && !email.draft && <li><Icon name="mail" /><a href={`mailto:${email.value}`}>{email.value}</a></li>}
        {area && !area.draft && <li><Icon name="pin" /><span>{area.value}</span></li>}
        <li><Icon name="chat" /><a href={CTA_NAV.href}>Écrire via le formulaire</a></li>
      </ul>
      {(phone?.draft || email?.draft || !phone || !email) && <Draft as="span" label="Coordonnées à fournir"><span /></Draft>}
      {social && !social.draft && (
        <ul role="list" class="site-footer__social">
          {social.value.map((s) => <li><a href={s.url} rel="me noopener" target="_blank">{s.label}<span class="sr-only"> (nouvel onglet)</span></a></li>)}
        </ul>
      )}
    </div>

    {
      groups.map((group) => (
        <nav class="site-footer__col" aria-label={group.title}>
          <h2 class="label">{group.title}</h2>
          <ul role="list">
            {group.items.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  <div class="page site-footer__bottom">
    <p>© {year} {site.name.value} · <em>{site.tagline.value}</em></p>
    <ul role="list">
      {LEGAL_NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-xl) var(--space-l);
    font-size: var(--step--1);
    overflow: hidden;
  }

  .footer-call {
    position: relative;
    padding-bottom: var(--space-xl);
    margin-bottom: var(--space-xl);
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
  }

  .footer-call__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    margin-top: var(--space-s);
    color: var(--craie) !important;
    text-decoration: none;
  }

  .footer-call__text {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 1.4rem + 6vw, 7rem);
    line-height: 0.88;
    letter-spacing: -0.03em;
  }

  .footer-call__text em {
    color: var(--lagon);
  }

  .footer-call__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: clamp(3.4rem, 2rem + 4vw, 5.5rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--lueur);
    color: var(--nuit);
    transition: transform var(--dur-slow) var(--ease-out), background-color var(--dur) ease;
  }

  .footer-call__icon :global(svg) {
    width: 40%;
    height: 40%;
  }

  .footer-call__link:hover .footer-call__icon {
    transform: rotate(-35deg) scale(1.05);
    background: var(--lagon);
  }

  .footer-call__fil {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1rem;
    width: 100%;
    height: 4rem;
    color: var(--lueur);
    opacity: 0.4;
  }

  .site-footer__grid {
    display: grid;
    gap: var(--space-l);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding-bottom: var(--space-l);
  }

  .site-footer__brand {
    grid-column: 1 / -1;
  }

  @media (min-width: 56rem) {
    .site-footer__grid {
      grid-template-columns: 1.3fr repeat(3, 1fr);
    }

    .site-footer__brand {
      grid-column: auto;
    }
  }

  .site-footer__brand {
    display: grid;
    gap: var(--space-m);
    align-content: start;
  }

  .footer-logo {
    display: inline-grid;
    justify-items: center;
    gap: 0.4rem;
    width: min(13rem, 100%);
    color: var(--lagon) !important;
    text-decoration: none;
  }

  .footer-logo__emblem {
    width: 60%;
    height: auto;
  }

  .footer-logo__word {
    width: 100%;
    height: auto;
    color: #2fb3ad;
  }

  .site-footer .label {
    margin-bottom: var(--space-s);
  }

  .site-footer ul {
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.1rem;
  }

  .site-footer a:not(.footer-call__link):not(.footer-logo) {
    display: inline-block;
    padding-block: 0.45rem;
    color: var(--craie);
    text-decoration: none;
  }

  .site-footer a:not(.footer-call__link):not(.footer-logo):hover {
    color: var(--lueur);
    text-decoration: underline;
  }

  .site-footer__contact li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .site-footer__contact :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--lagon);
    flex: none;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-s);
    padding-top: var(--space-m);
    border-top: 1px solid rgb(255 255 255 / 0.12);
    color: var(--craie-douce);
  }

  .site-footer__bottom ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
  }

  .site-footer__bottom a {
    color: var(--craie-douce) !important;
  }
</style>
