---
/**
 * « Où en êtes-vous avec votre chien ? » — sélecteur en constellation photographique.
 * Les quatre chemins d'accompagnement sont quatre photos-étoiles reliées entre elles ; choisir
 * sa situation tire un trait de lumière depuis « vous » vers la photo correspondante et révèle
 * le chemin. Sans JavaScript, les quatre chemins sont listés. Clavier (flèches), toucher, souris.
 */
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import { ACCOMPAGNEMENTS } from '~/content/accompagnements';

const OPTIONS: Record<string, { choice: string; stage: string; x: number; y: number; photo: string }> = {
  chiot: { choice: 'Un chiot arrive, ou vient d’arriver', stage: 'chiot-arrive', x: 170, y: 110, photo: 'chiot-labrador' },
  'chien-adulte': { choice: 'Un chien adulte partage notre vie', stage: 'adopte', x: 420, y: 80, photo: 'balade-sentier-duo' },
  quotidien: { choice: 'Une situation du quotidien nous pèse', stage: 'installe', x: 500, y: 300, photo: 'maison-golden' },
  comprendre: { choice: 'Nous aimerions simplement mieux le comprendre', stage: 'installe', x: 270, y: 320, photo: 'observe-duo' },
};
const ME = { x: 56, y: 440 };
const items = ACCOMPAGNEMENTS.map((a) => ({ a, ...OPTIONS[a.slug]! }));
const curve = (x: number, y: number) => `M${ME.x} ${ME.y} Q ${(ME.x + x) / 2 - 40} ${(ME.y + y) / 2 - 90} ${x} ${y}`;
const POS: Record<string, string> = { chiot: 'p1', 'chien-adulte': 'p2', quotidien: 'p3', comprendre: 'p4' };
---
<section class="ch" aria-labelledby="ch-title" data-chooser>
  <div class="page ch__grid">
    <div class="ch__intro">
      <p class="eyebrow">Quatre chemins</p>
      <h2 id="ch-title">Où en êtes-vous <em>avec votre chien</em>&nbsp;?</h2>
      <p class="lede">Choisissez ce qui vous ressemble aujourd’hui&nbsp;: le chemin d’accompagnement le plus proche s’éclaire.</p>
      <div class="ch__options" role="radiogroup" aria-labelledby="ch-title" data-ch-options>
        {
          items.map(({ a, choice }, i) => (
            <button type="button" class="ch__option" role="radio" aria-checked="false" tabindex={i === 0 ? 0 : -1} data-ch-pick={a.slug}>
              <span class="ch__num" aria-hidden="true">{a.num}</span>
              <span>{choice}</span>
            </button>
          ))
        }
      </div>
    </div>

    <div class="ch__stage">
      <div class="ch__map">
        <svg class="ch__sky" viewBox="0 0 600 480" aria-hidden="true" focusable="false">
          <polyline class="ch__web" points={items.map((i) => `${i.x},${i.y}`).join(' ') + ` ${items[0]!.x},${items[0]!.y}`} />
          {items.map((i) => <path class="ch__ray" data-ch-ray={i.a.slug} d={curve(i.x, i.y)} pathLength="1" />)}
          <g class="ch__me">
            <circle cx={ME.x} cy={ME.y} r="20" class="ch__halo" />
            <circle cx={ME.x} cy={ME.y} r="6" class="ch__core" />
            <text x={ME.x + 18} y={ME.y + 6} class="ch__label">vous</text>
          </g>
        </svg>
        {
          items.map((i) => (
            <div class:list={['ch__node', `ch__node--${POS[i.a.slug]}`]} data-ch-star={i.a.slug} aria-hidden="true">
              <Photo id={i.photo} shape="round" credit="none" sizes="(min-width: 60rem) 11rem, 28vw" />
              <span class="ch__node-num">{i.a.num}</span>
            </div>
          ))
        }
      </div>

      <div class="ch__panels">
        <div class="ch__panel ch__panel--invite" data-ch-panel="">
          <span class="ch__invite-star" aria-hidden="true"></span>
          <p class="ch__invite">Sélectionnez une situation&nbsp;: un trait relie votre point de départ au chemin qui s’en approche le plus.</p>
        </div>
        {
          items.map(({ a, stage }) => (
            <article class="ch__panel" data-ch-panel={a.slug} aria-labelledby={`ch-${a.slug}`}>
              <p class="label">Chemin {a.num}</p>
              <h3 id={`ch-${a.slug}`}>{a.label}</h3>
              <p>{a.short}</p>
              <ul role="list">{a.repères.map((r) => <li>{r.title}</li>)}</ul>
              <div class="ch__links">
                <a class="btn btn--sm" href={`/accompagnements/${a.slug}/`}>Explorer ce chemin <Icon name="arrow" class="btn__arrow" /></a>
                <a class="link-arrow" href={`/orientation/?stage=${stage}`}>Affiner en quatre questions <Icon name="arrow" /></a>
              </div>
            </article>
          ))
        }
      </div>
      <p class="ch__credits">
        Photos d’illustration :
        {items.map((i, k) => <>{k > 0 && ' · '}<a href={`/credits-photos/#${i.photo}`}>{i.a.num}</a></>)}
      </p>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-chooser]').forEach((root) => {
    const options = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-ch-pick]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-ch-panel]'));
    root.classList.add('is-live');
    const pick = (slug: string, focus = false) => {
      root.dataset.choice = slug;
      options.forEach((o) => {
        const on = o.dataset.chPick === slug;
        o.setAttribute('aria-checked', String(on));
        o.tabIndex = on ? 0 : -1;
        if (on && focus) o.focus();
      });
      root.querySelectorAll<SVGElement>('[data-ch-ray]').forEach((r) => r.classList.toggle('is-on', r.dataset.chRay === slug));
      root.querySelectorAll<HTMLElement>('[data-ch-star]').forEach((s) => s.classList.toggle('is-on', s.dataset.chStar === slug));
      panels.forEach((p) => p.classList.toggle('is-on', p.dataset.chPanel === slug));
    };
    options.forEach((o, i) => {
      o.addEventListener('click', () => pick(o.dataset.chPick!));
      o.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        pick(options[(i + d + options.length) % options.length]!.dataset.chPick!, true);
      });
    });
    root.querySelectorAll<HTMLElement>('[data-ch-star]').forEach((s) => s.addEventListener('click', () => pick(s.dataset.chStar!)));
    panels.find((p) => p.dataset.chPanel === '')?.classList.add('is-on');
  });
</script>

<style>
  .ch {
    padding-block: var(--space-xl);
    background:
      radial-gradient(60% 70% at 85% 30%, var(--soleil), transparent 70%),
      linear-gradient(180deg, var(--papier), var(--aube));
    overflow: hidden;
  }

  .ch__grid {
    display: grid;
    gap: var(--space-l);
    align-items: center;
  }

  @media (min-width: 60rem) {
    .ch__grid {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-xl);
    }
  }

  .ch__intro {
    display: grid;
    gap: var(--space-s);
  }

  .ch__intro h2 em {
    color: var(--sarcelle);
  }

  .ch__options {
    display: grid;
    gap: 0.5rem;
    margin-top: var(--space-s);
  }

  .ch__option {
    display: flex;
    gap: var(--space-s);
    align-items: center;
    min-height: 3.2rem;
    padding: 0.7rem 1rem;
    border: 1.5px solid color-mix(in oklab, var(--encre) 14%, transparent);
    border-radius: var(--radius-m);
    background: var(--blanc);
    color: var(--encre);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: border-color var(--dur) ease, background-color var(--dur) ease, transform var(--dur) var(--ease-out), box-shadow var(--dur) ease;
  }

  .ch__option:hover {
    border-color: var(--turquoise);
    transform: translateX(4px);
  }

  .ch__option[aria-checked='true'] {
    border-color: var(--sarcelle);
    background: color-mix(in oklab, var(--turquoise) 10%, var(--blanc));
    box-shadow: 0 0.8rem 1.8rem -1.4rem rgb(14 95 91 / 0.6);
  }

  .ch__option:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  .ch__num {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--sarcelle);
  }

  .ch__stage {
    display: grid;
    gap: var(--space-m);
  }

  .ch__map {
    position: relative;
    aspect-ratio: 5 / 4;
  }

  .ch__sky {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .ch__web {
    fill: none;
    stroke: color-mix(in oklab, var(--turquoise) 35%, transparent);
    stroke-width: 1.2;
    stroke-dasharray: 2 7;
  }

  .ch__ray {
    fill: none;
    stroke: var(--turquoise);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 900ms var(--ease-out);
  }

  .ch__ray.is-on {
    stroke-dashoffset: 0;
  }

  .ch__halo {
    fill: rgb(17 150 147 / 0.15);
  }

  .ch__core {
    fill: var(--turquoise);
  }

  .ch__label {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 22px;
    fill: var(--sarcelle);
  }

  .ch__node {
    position: absolute;
    width: 22%;
    margin: -11% 0 0 -11%;
    cursor: pointer;
    transition: transform 600ms var(--ease-out), filter 400ms ease;
  }

  .ch__node :global(.ph) {
    padding: 0.3rem;
    border-radius: 50%;
    background: var(--blanc);
    box-shadow: 0 1rem 2rem -1.4rem rgb(20 60 55 / 0.6);
    transition: box-shadow 400ms ease;
  }

  .ch__node--p1 {
    left: calc(170 / 600 * 100%);
    top: calc(110 / 480 * 100%);
  }

  .ch__node--p2 {
    left: calc(420 / 600 * 100%);
    top: calc(80 / 480 * 100%);
  }

  .ch__node--p3 {
    left: calc(500 / 600 * 100%);
    top: calc(300 / 480 * 100%);
  }

  .ch__node--p4 {
    left: calc(270 / 600 * 100%);
    top: calc(320 / 480 * 100%);
  }

  .ch__node-num {
    position: absolute;
    right: -0.2rem;
    top: -0.2rem;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--blanc);
    color: var(--sarcelle);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    box-shadow: 0 0 0 2px var(--turquoise);
  }

  .is-live[data-choice] .ch__node:not(.is-on) {
    filter: saturate(0.45) opacity(0.75);
  }

  .ch__node.is-on {
    transform: scale(1.12);
  }

  .ch__node.is-on :global(.ph) {
    box-shadow: 0 0 0 4px var(--turquoise), 0 1.4rem 2.6rem -1.4rem rgb(20 60 55 / 0.7);
  }

  .ch__panels {
    display: grid;
  }

  .is-live .ch__panels {
    grid-template-areas: 'stack';
  }

  .ch__panel {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding: var(--space-m);
    border-radius: var(--radius-l);
    background: var(--blanc);
    box-shadow: 0 1.4rem 3rem -2.4rem rgb(20 60 55 / 0.55);
  }

  .is-live .ch__panel {
    grid-area: stack;
    opacity: 0;
    visibility: hidden;
    transform: translateY(0.6rem);
    transition: opacity 400ms var(--ease-out), transform 500ms var(--ease-out), visibility 0s 400ms;
  }

  .is-live .ch__panel.is-on {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 120ms, 120ms, 0s;
  }

  .ch:not(.is-live) .ch__panel--invite {
    display: none;
  }

  .ch:not(.is-live) .ch__panel + .ch__panel {
    margin-top: var(--space-s);
  }

  .ch__panel--invite {
    display: flex;
    gap: var(--space-s);
    align-items: center;
    background: transparent;
    box-shadow: none;
    padding-inline: 0;
  }

  .ch__invite-star {
    flex: none;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: var(--turquoise);
    box-shadow: 0 0 0 5px rgb(17 150 147 / 0.18);
  }

  .ch__invite {
    color: var(--encre-douce);
    font-style: italic;
  }

  .ch__panel h3 {
    font-size: var(--step-2);
  }

  .ch__panel ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0;
    list-style: none;
  }

  .ch__panel li {
    padding: 0.25rem 0.7rem;
    border-radius: var(--radius-pill);
    background: var(--lin);
    font-size: var(--step--1);
  }

  .ch__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-m);
    align-items: center;
    margin-top: 0.3rem;
  }

  .ch__credits {
    font-size: 0.72rem;
    color: var(--encre-douce);
  }

  .ch__credits a {
    color: inherit;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ch__node--p1 :global(.ph) {
      animation: ch-float 10s ease-in-out infinite;
    }

    .ch__node--p2 :global(.ph) {
      animation: ch-float 12s ease-in-out -3s infinite;
    }

    .ch__node--p3 :global(.ph) {
      animation: ch-float 11s ease-in-out -6s infinite;
    }

    .ch__node--p4 :global(.ph) {
      animation: ch-float 13s ease-in-out -2s infinite;
    }
  }

  @keyframes ch-float {
    50% {
      transform: translateY(-6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ch__ray,
    .is-live .ch__panel {
      transition: none;
    }
  }
</style>
