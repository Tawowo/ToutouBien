---
/**
 * La galerie. Trois familles d'images, toujours distinguées :
 *  1. les photos authentiques de l'activité (src/assets/photos/galerie/ + galerie.json) ;
 *  2. les photographies d'illustration libres de droits, créditées, jamais présentées comme des chiens accompagnés ;
 *  3. le carnet graphique : les compositions originales de ToutouBien.
 * Toutes s'ouvrent dans la même visionneuse accessible.
 */
import type { ImageMetadata } from 'astro';
import { Picture, getImage } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import SplitTitle from '~/components/SplitTitle.astro';
import Draft from '~/components/Draft.astro';
import Icon from '~/components/Icon.astro';
import meta from '~/content/galerie.json';
import { LIBRARY, focusClass } from '~/lib/library';
import { draftsVisible } from '~/lib/fields';

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/galerie/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const info = meta as Record<string, { alt?: string; legende?: string }>;
const authentic = await Promise.all(
  Object.entries(files)
    .map(([path, mod]) => ({ name: path.split('/').pop()!, img: mod.default, ...info[path.split('/').pop()!] }))
    .filter((p): p is typeof p & { alt: string } => typeof p.alt === 'string' && p.alt.trim().length > 0)
    .map(async (p) => ({ ...p, full: (await getImage({ src: p.img, width: 1800, format: 'webp' })).src })),
);

const THEMES: [string, string][] = [
  ['lien', 'Avec leur humain'],
  ['balade', 'En balade'],
  ['flair', 'Le flair'],
  ['jeu', 'Le jeu'],
  ['rencontre', 'Rencontres'],
  ['rappel', 'Le rappel'],
  ['chiot', 'Chiots'],
  ['maison', 'À la maison'],
  ['attente', 'L’attente'],
  ['senior', 'Chiens âgés'],
  ['nature', 'Nature'],
  ['observe', 'Observer'],
  ['portrait', 'Portraits'],
];
const illustrative = await Promise.all(
  LIBRARY.map(async (p) => ({ p, full: (await getImage({ src: p.img, width: 1024, format: 'webp' })).src })),
);
const preprod = draftsVisible();
const SLOTS = ['Mme Petitgand et son chien', 'Une séance en extérieur', 'Une balade en groupe', 'Le lieu de travail', 'Un moment de complicité', 'Le matériel utilisé'];
---
<Base title="Galerie" description="La galerie ToutouBien : des instants en images, des photographies d’illustration créditées et le carnet graphique de la marque.">
  <section class="gh" data-sky="0.45">
    <div class="page gh__inner">
      <p class="eyebrow enter">Galerie</p>
      <SplitTitle as="h1" text="Des instants, *en images*." now />
      <p class="lede enter" data-i="3">Les photographies de l’activité sont publiées uniquement avec l’accord des familles. Les photographies d’illustration, sous licence libre et créditées, ne montrent pas de chiens accompagnés par ToutouBien.</p>
    </div>
  </section>

  <section class="section section--tight g-lib" aria-labelledby="g-illus" data-gal>
    <div class="page">
      <header class="g-head">
        <h2 id="g-illus">Des chiens, <em>tout simplement</em></h2>
        <p class="label">{illustrative.length} photographies d’illustration · licence CC BY 2.0</p>
      </header>
      <div class="g-filters" role="group" aria-label="Filtrer par thème" data-gal-filters hidden>
        <button type="button" class="chip" aria-pressed="true" data-gal-theme="">Toutes</button>
        {THEMES.filter(([id]) => LIBRARY.some((p) => p.theme === id)).map(([id, label]) => <button type="button" class="chip" aria-pressed="false" data-gal-theme={id}>{label}</button>)}
      </div>
      <p class="g-count" aria-live="polite" data-gal-count></p>
      <ul class="g-masonry" role="list">
        {illustrative.map(({ p, full }) => (
          <li class="g-tile" data-theme={p.theme}>
            <button type="button" class="g-thumb" data-lb data-lb-full={full} data-lb-alt={p.alt} data-lb-caption={`${p.caption} Photo : ${p.author}, ${p.licence}.`} aria-label={`Agrandir : ${p.caption}`}>
              <Picture src={p.img} alt="" formats={['avif', 'webp']} widths={[400, 640]} sizes="(min-width: 75rem) 22vw, (min-width: 48rem) 30vw, 46vw" loading="lazy" class={focusClass(p)} />
            </button>
            <p class="g-tile__cap">{p.caption} <a href={p.sourceUrl} rel="noopener">{p.author}</a> · <a href={p.licenceUrl} rel="license noopener">{p.licence}</a></p>
          </li>
        ))}
      </ul>
      <p class="g-legal">Ces photos d’illustration ne montrent ni Mme Petitgand, ni des chiens qu’elle accompagne. <a href="/credits-photos/">Tous les crédits</a></p>
    </div>
  </section>

  {
    (authentic.length > 0 || preprod) && (
      <section class="section section--tight" aria-labelledby="g-auth">
        <div class="page">
          <header class="g-head">
            <h2 id="g-auth">L’activité <em>au quotidien</em></h2>
            <p class="label">Photos authentiques</p>
          </header>
          {authentic.length > 0 ? (
            <ul class="g-grid" role="list">
              {authentic.map((p, i) => (
                <li class:list={['g-item', 'reveal', i % 6 === 0 && 'g-item--tall', i % 6 === 3 && 'g-item--wide']}>
                  <button type="button" class="g-thumb" data-lb data-lb-full={p.full} data-lb-alt={p.alt} data-lb-caption={p.legende ?? p.alt} aria-label={`Agrandir : ${p.legende ?? p.alt}`}>
                    <Picture src={p.img} alt="" formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes="(min-width: 60rem) 33vw, 92vw" loading="lazy" />
                  </button>
                  {p.legende && <p class="g-cap">{p.legende}</p>}
                </li>
              ))}
            </ul>
          ) : (
            <Draft label="Photos à fournir">
              <p>Emplacements prévus pour les photos de Mme Petitgand (déposer les fichiers dans <code>src/assets/photos/galerie/</code> et leurs légendes dans <code>src/content/galerie.json</code>). Ce bloc n’apparaît pas en production.</p>
              <ul class="g-grid g-grid--slots" role="list">
                {SLOTS.map((s, i) => (
                  <li class:list={['g-slot', i % 6 === 0 && 'g-item--tall', i % 6 === 3 && 'g-item--wide']}>
                    <span>{s}</span>
                  </li>
                ))}
              </ul>
            </Draft>
          )}
        </div>
      </section>
    )
  }

  <section class="section on-lin g-next" aria-labelledby="g-next">
    <div class="page g-next__inner">
      <h2 id="g-next">Envie de nous <em>rencontrer</em>&nbsp;?</h2>
      <div class="g-next__links">
        <a class="btn" href="/contact/">Me contacter <Icon name="arrow" class="btn__arrow" /></a>
        <a class="link-arrow" href="/qui-suis-je/">Qui suis-je <Icon name="arrow" /></a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { initLightbox } from '~/scripts/lightbox';

  // Filtres par thème (amélioration progressive : sans JavaScript, toutes les photos sont visibles).
  const root = document.querySelector<HTMLElement>('[data-gal]');
  if (root) {
    const bar = root.querySelector<HTMLElement>('[data-gal-filters]')!;
    const chips = Array.from(bar.querySelectorAll<HTMLButtonElement>('[data-gal-theme]'));
    const tiles = Array.from(root.querySelectorAll<HTMLElement>('.g-tile'));
    const count = root.querySelector<HTMLElement>('[data-gal-count]')!;
    bar.hidden = false;
    const apply = (theme: string) => {
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.galTheme === theme)));
      let n = 0;
      tiles.forEach((t) => {
        const on = !theme || t.dataset.theme === theme;
        t.hidden = !on;
        if (on) n++;
      });
      count.textContent = theme ? `${n} photo${n > 1 ? 's' : ''}` : '';
      document.dispatchEvent(new CustomEvent('lightbox:refresh'));
    };
    chips.forEach((c) => c.addEventListener('click', () => apply(c.dataset.galTheme ?? '')));
  }
  initLightbox();
</script>

<style>
  .gh {
    padding-block: var(--space-xl) var(--space-l);
    background: linear-gradient(180deg, var(--lin), var(--papier));
  }

  .gh__inner {
    display: grid;
    gap: var(--space-m);
  }

  .gh h1 {
    font-size: var(--step-6);
    line-height: 0.95;
    max-width: 12ch;
  }

  .gh h1 :global(em),
  .g-head h2 em,
  .g-next h2 em {
    color: var(--sarcelle);
  }

  .gh .lede {
    max-width: 60ch;
  }

  .g-head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-m);
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-l);
  }

  .g-grid {
    display: grid;
    gap: var(--space-s);
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    grid-auto-rows: 15rem;
    grid-auto-flow: dense;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .g-item--wide {
      grid-column: span 2;
    }

    .g-item--tall {
      grid-row: span 2;
    }
  }

  .g-item {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-l);
  }

  .g-thumb {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: var(--lin);
    cursor: zoom-in;
  }

  .g-thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s var(--ease-out);
  }

  .g-thumb:hover :global(img),
  .g-thumb:focus-visible :global(img) {
    transform: scale(1.05);
  }

  .g-thumb:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: -3px;
  }

  .g-cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 2rem 0.9rem 0.7rem;
    background: linear-gradient(transparent, rgb(8 30 28 / 0.75));
    color: var(--craie);
    font-size: var(--step--1);
    pointer-events: none;
  }

  .g-cap--credit a {
    color: inherit;
    pointer-events: auto;
  }

  .g-slot {
    display: grid;
    place-items: center;
    padding: var(--space-m);
    border-radius: var(--radius-l);
    border: 1.5px dashed color-mix(in oklab, var(--sarcelle) 55%, transparent);
    background: repeating-linear-gradient(-45deg, transparent 0 12px, color-mix(in oklab, var(--turquoise) 10%, transparent) 12px 13px);
    text-align: center;
    font-size: var(--step--1);
    color: var(--encre-douce);
  }

  .g-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: var(--space-s);
  }

  .g-filters[hidden] {
    display: none;
  }

  .chip {
    min-height: 2.6rem;
    padding: 0 1rem;
    border-radius: var(--radius-pill);
    border: 1.5px solid color-mix(in oklab, var(--encre) 18%, transparent);
    background: var(--blanc);
    font: inherit;
    font-size: var(--step--1);
    color: var(--encre);
    cursor: pointer;
    transition: background-color var(--dur) ease, border-color var(--dur) ease;
  }

  .chip:hover {
    border-color: var(--turquoise);
  }

  .chip[aria-pressed='true'] {
    background: var(--sarcelle);
    border-color: var(--sarcelle);
    color: #fff;
  }

  .chip:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  .g-count {
    min-height: 1.5em;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--sarcelle);
  }

  .g-masonry {
    columns: 2 12rem;
    column-gap: var(--space-s);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .g-masonry {
      columns: 3;
    }
  }

  @media (min-width: 75rem) {
    .g-masonry {
      columns: 4;
    }
  }

  .g-tile {
    break-inside: avoid;
    margin-bottom: var(--space-s);
  }

  .g-tile[hidden] {
    display: none;
  }

  .g-tile .g-thumb {
    height: auto;
    border-radius: var(--radius-m);
    overflow: hidden;
  }

  .g-tile .g-thumb :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .g-tile__cap {
    margin-top: 0.35rem;
    font-size: 0.75rem;
    color: var(--encre-douce);
  }

  .g-tile__cap a {
    color: inherit;
  }

  .g-legal {
    margin-top: var(--space-m);
    font-size: var(--step--1);
    color: var(--encre-douce);
  }

  .g-next__inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    align-items: center;
    justify-content: space-between;
  }

  .g-next__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    align-items: center;
  }
</style>
