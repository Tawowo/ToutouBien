---
/**
 * Travelling photographique en profondeur.
 * Le défilement vertical fait glisser horizontalement trois plans de photographies qui avancent
 * à des vitesses différentes (parallaxe réelle) ; chaque photo pivote selon sa place à l'écran
 * (perspective) et son image intérieure glisse dans son cadre. Un fil d'étoiles se dessine au fil
 * du travelling et relie les photos du premier plan.
 *
 * Mobile : deux plans, photos plus grandes. Mouvement réduit ou sans JavaScript : simple bande
 * défilable horizontalement (aimantée), sans épinglage.
 */
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { photo as libPhoto } from '~/lib/library';

interface Item {
  id: string;
  /** 0 : premier plan (grand) · 1 : plan médian · 2 : arrière-plan (petit, plus lent). */
  layer: 0 | 1 | 2;
  /** Position verticale dans la scène (% de la hauteur utile). */
  y: number;
  caption?: boolean;
}

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  lede: string;
  items: Item[];
  link?: { href: string; label: string };
}
const { id, eyebrow, title, lede, items, link } = Astro.props;
const html = title.replace(/\*(.+?)\*/g, '<em>$1</em>');
// Position horizontale : les photos de chaque plan sont réparties régulièrement le long du travelling.
const byLayer = [0, 1, 2].map((l) => items.filter((it) => it.layer === l));
const placed = items.map((it) => {
  const list = byLayer[it.layer]!;
  const k = list.indexOf(it);
  const x = ((k + 0.5) / list.length) * 100;
  return { ...it, x, p: libPhoto(it.id) };
});
---
<section class="tv" aria-labelledby={`${id}-title`} data-travel>
  <div class="tv__sticky">
    <header class="page tv__head">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id={`${id}-title`} set:html={html} />
      <p class="lede">{lede}</p>
      {link && <a class="link-arrow" href={link.href}>{link.label} <Icon name="arrow" /></a>}
    </header>
    <div class="tv__stage">
      {[2, 1, 0].map((l) => (
        <ul class:list={['tv__layer', `tv__layer--${l}`]} role="list" data-tv-layer={l} aria-label={l === 0 ? 'Photographies' : undefined} inert={l === 0 ? undefined : true}>
          {placed.filter((p) => p.layer === l).map((p) => (
            <li class="tv__item" data-tv-item data-x={p.x} data-y={p.y}>
              <Photo id={p.id} shape="soft" ratio={l === 0 ? '4-5' : l === 1 ? '4-3' : '1'} credit={l === 2 ? 'none' : 'overlay'} sizes={l === 0 ? '(min-width: 60rem) 24vw, 62vw' : '(min-width: 60rem) 15vw, 40vw'} />
              {l === 0 && p.caption && <p class="tv__cap">{p.p.caption}</p>}
            </li>
          ))}
        </ul>
      ))}
      <svg class="tv__thread" aria-hidden="true" focusable="false" preserveAspectRatio="none" data-tv-thread>
        <polyline points="" pathLength="1" />
      </svg>
    </div>
    <div class="tv__progress" aria-hidden="true"><span></span></div>
  </div>
</section>

<script>
  /**
   * Moteur du travelling. Toutes les mesures sont faites au redimensionnement (aucune lecture de mise en
   * page pendant le défilement) ; chaque image ne fait qu'écrire des transformations.
   *  - Calage : la première photo du premier plan entre à droite (64 % de la largeur), la dernière finit
   *    à gauche (40 %) ; courtes pauses au début et à la fin, vitesse adoucie aux deux extrémités.
   *  - Trajectoires : chaque photo décrit un arc (elle monte légèrement en passant au centre), grandit un peu,
   *    pivote selon sa place ; les trois plans ont des vitesses propres (parallaxe réelle).
   *  - Fil d'étoiles : il relie les photos du premier plan et se dessine jusqu'au centre de l'écran ;
   *    chaque étoile s'allume quand sa photo passe au centre, dont la légende apparaît alors.
   */
  document.querySelectorAll<HTMLElement>('[data-travel]').forEach((root) => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    root.classList.add('is-live');
    const stage = root.querySelector<HTMLElement>('.tv__stage')!;
    const svg = root.querySelector<SVGSVGElement>('[data-tv-thread]')!;
    const thread = svg.querySelector('polyline')!;
    const bar = root.querySelector<HTMLElement>('.tv__progress span')!;
    const NS = 'http://www.w3.org/2000/svg';
    const SPAN = [3.1, 2.3, 1.6];
    const ARC = [26, 14, 6];
    type Item = { el: HTMLElement; off: number; top: number; h: number; w: number; dot?: SVGCircleElement };
    type Layer = { el: HTMLElement; l: number; items: Item[]; first: number; last: number };
    const layers: Layer[] = Array.from(root.querySelectorAll<HTMLElement>('[data-tv-layer]')).map((el) => ({
      el,
      l: Number(el.dataset.tvLayer),
      items: Array.from(el.querySelectorAll<HTMLElement>('[data-tv-item]')).map((it) => ({ el: it, off: 0, top: 0, h: 0, w: 0 })),
      first: 0,
      last: 0,
    }));
    const front = layers.find((L) => L.l === 0)!;
    front.items.forEach((it) => {
      const c = document.createElementNS(NS, 'circle');
      c.setAttribute('r', '5');
      c.classList.add('tv__dot');
      svg.append(c);
      it.dot = c;
    });
    let W = 0;
    let H = 0;
    let ticking = false;
    let visible = false;

    const layout = () => {
      W = stage.clientWidth;
      H = stage.clientHeight;
      const mobile = W < 720;
      for (const L of layers) {
        const lw = W * (mobile ? SPAN[L.l]! * 1.35 : SPAN[L.l]!);
        L.el.style.width = `${lw}px`;
        for (const it of L.items) {
          it.el.style.left = `${it.el.dataset.x}%`;
          it.w = it.el.offsetWidth;
          // Position du centre de la photo dans sa couche.
          it.off = (Number(it.el.dataset.x) / 100) * lw + it.w / 2;
          it.h = it.el.offsetHeight;
          // Bornes verticales : la photo (et sa légende) reste dans la scène, quelle que soit la hauteur d'écran.
          const want = (Number(it.el.dataset.y) / 100) * H;
          it.top = Math.max(0, Math.min(want, H - it.h - (L.l === 0 ? 34 : 8)));
          it.el.style.top = `${it.top.toFixed(1)}px`;
        }
        L.first = Math.min(...L.items.map((i) => i.off));
        L.last = Math.max(...L.items.map((i) => i.off));
      }
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
      update();
    };

    const ease = (t: number) => t * t * (3 - 2 * t);

    const update = () => {
      ticking = false;
      const r = root.getBoundingClientRect();
      const span = r.height - innerHeight;
      const p = span > 0 ? Math.min(1, Math.max(0, -r.top / span)) : 0;
      // Pauses de 5 % au début et à la fin ; vitesse adoucie aux extrémités.
      const q = ease(Math.min(1, Math.max(0, (p - 0.05) / 0.9)));
      bar.style.transform = `scaleX(${p.toFixed(4)})`;
      const pts: [number, number][] = [];
      for (const L of layers) {
        const start = W * 0.64 - L.first;
        const end = W * 0.4 - L.last;
        const x = start + (end - start) * q;
        L.el.style.transform = `translate3d(${x.toFixed(1)}px, 0, 0)`;
        for (const it of L.items) {
          const cx = x + it.off;
          const rel = (cx - W / 2) / W; // -0.5 … 0.5 dans l'écran
          const near = Math.max(0, 1 - Math.abs(rel) * 1.7); // 1 au centre
          const rot = Math.max(-1, Math.min(1, rel * 1.6)) * (L.l === 0 ? -15 : -8);
          const lift = -ARC[L.l]! * Math.cos(Math.max(-1, Math.min(1, rel * 2)) * Math.PI * 0.5);
          const scale = L.l === 0 ? 0.9 + near * 0.12 : 1;
          it.el.style.transform = `perspective(1100px) translate3d(0, ${lift.toFixed(1)}px, ${(near * (L.l === 0 ? 50 : 16)).toFixed(1)}px) rotateY(${rot.toFixed(2)}deg) scale(${scale.toFixed(3)})`;
          it.el.style.setProperty('--shift', `${(rel * -14).toFixed(2)}%`);
          if (L.l === 0) {
            const y = it.top + it.h * 0.5 + lift;
            pts.push([cx, y]);
            it.el.classList.toggle('is-center', Math.abs(rel) < 0.14);
            const dot = it.dot!;
            // L'étoile marque le point où le fil s'accroche au bord gauche de la photo.
            dot.setAttribute('cx', (cx - (it.w / 2) * scale).toFixed(1));
            dot.setAttribute('cy', y.toFixed(1));
            dot.classList.toggle('is-lit', cx < W * 0.5 + it.w * 0.5);
          }
        }
      }
      // Le fil se dessine jusqu'au centre de l'écran.
      pts.sort((a, b) => a[0] - b[0]);
      let total = 0;
      let reach = 0;
      for (let i = 1; i < pts.length; i++) {
        const [x0, y0] = pts[i - 1]!;
        const [x1, y1] = pts[i]!;
        const seg = Math.hypot(x1 - x0, y1 - y0);
        if (x1 <= W / 2) reach += seg;
        else if (x0 < W / 2) reach += seg * ((W / 2 - x0) / (x1 - x0));
        total += seg;
      }
      thread.setAttribute('points', pts.map(([a, b]) => `${a.toFixed(1)},${b.toFixed(1)}`).join(' '));
      thread.style.strokeDashoffset = String(total > 0 ? 1 - reach / total : 1);
    };

    const onScroll = () => {
      if (!ticking && visible) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    // Les photos hors champ (à droite) ne seraient jamais « proches » pour le chargement différé natif :
    // on les charge toutes quand la section approche.
    new IntersectionObserver((e, io) => {
      if (e.some((x) => x.isIntersecting)) {
        root.querySelectorAll<HTMLImageElement>('img[loading="lazy"]').forEach((img) => (img.loading = 'eager'));
        io.disconnect();
      }
    }, { rootMargin: '100% 0px' }).observe(root);
    new IntersectionObserver((e) => {
      visible = e.some((x) => x.isIntersecting);
      if (visible) onScroll();
    }, { rootMargin: '200px 0px' }).observe(root);
    addEventListener('scroll', onScroll, { passive: true });
    // Les photos changent de taille quand elles se chargent ou au redimensionnement : on remesure.
    const ro = new ResizeObserver(() => requestAnimationFrame(layout));
    ro.observe(stage);
    root.querySelectorAll('img').forEach((img) => img.addEventListener('load', () => requestAnimationFrame(layout), { once: true }));
    layout();
  });
</script>

<style>
  .tv {
    position: relative;
    background:
      radial-gradient(60% 50% at 80% 30%, rgb(255 240 210 / 0.7), transparent 70%),
      linear-gradient(180deg, var(--papier), var(--ciel) 50%, var(--papier));
  }

  .tv__head {
    display: grid;
    gap: var(--space-s);
    max-width: 44rem;
    padding-block: var(--space-xl) var(--space-m);
  }

  .tv__head h2 :global(em) {
    color: var(--sarcelle);
  }

  /* Repli : bande horizontale défilable. */
  .tv__stage {
    position: relative;
  }

  .tv__layer {
    display: flex;
    gap: var(--space-m);
    padding: 0 var(--gutter) var(--space-l);
    margin: 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }

  .tv__layer--1,
  .tv__layer--2 {
    display: none;
  }

  .tv__item {
    flex: none;
    width: min(70vw, 20rem);
    scroll-snap-align: center;
  }

  .tv__cap {
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-style: italic;
    color: var(--encre-douce);
  }

  .tv__thread,
  .tv__progress {
    display: none;
  }

  /* Travelling épinglé. */
  .tv.is-live {
    height: calc(var(--tv-len, 3) * 100svh);
  }

  .tv.is-live .tv__sticky {
    position: sticky;
    top: 0;
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100svh;
    overflow: hidden;
  }

  .tv.is-live .tv__head {
    padding-block: 5.5rem 0;
    z-index: 4;
    gap: var(--space-2xs);
  }

  .tv.is-live .tv__stage {
    overflow: visible;
  }

  .tv.is-live .tv__layer {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    display: block;
    padding: 0;
    overflow: visible;
    will-change: transform;
  }

  .tv.is-live .tv__item {
    position: absolute;
    translate: -50% 0;
    will-change: transform;
  }

  .tv.is-live .tv__layer--0 {
    z-index: 3;
  }

  .tv.is-live .tv__layer--0 .tv__item {
    width: min(22vw, 20rem, (100svh - 21rem) * 0.72);
  }

  .tv.is-live .tv__layer--1 {
    z-index: 2;
  }

  .tv.is-live .tv__layer--1 .tv__item {
    width: min(15vw, 13rem);
    opacity: 0.92;
  }

  .tv.is-live .tv__layer--2 {
    z-index: 1;
  }

  .tv.is-live .tv__layer--2 .tv__item {
    width: min(9vw, 8rem);
    opacity: 0.7;
    filter: saturate(0.8);
  }

  .tv.is-live .tv__item :global(.ph__frame) {
    box-shadow: 0 2rem 3.5rem -2rem rgb(20 60 55 / 0.55);
  }

  /* L'image glisse dans son cadre : profondeur supplémentaire. */
  .tv.is-live .tv__item :global(img) {
    transform: translateX(var(--shift, 0)) scale(1.18);
  }

  .tv.is-live .tv__thread {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .tv__thread :global(.tv__dot) {
    fill: var(--blanc);
    stroke: var(--turquoise);
    stroke-width: 2;
    transition: fill 400ms ease, r 400ms ease;
  }

  .tv__thread :global(.tv__dot.is-lit) {
    fill: var(--turquoise);
    r: 6;
  }

  /* Une seule légende à la fois : celle de la photo qui passe au centre. */
  .tv.is-live .tv__cap {
    opacity: 0;
    transform: translateY(0.4rem);
    transition: opacity 400ms ease, transform 500ms var(--ease-out);
  }

  .tv.is-live .tv__item.is-center .tv__cap {
    opacity: 1;
    transform: none;
  }

  .tv__thread polyline {
    fill: none;
    stroke: var(--turquoise);
    stroke-width: 2;
    stroke-dasharray: 1;
    stroke-linejoin: round;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .tv.is-live .tv__progress {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 1.4rem;
    z-index: 4;
    display: block;
    height: 2px;
    background: rgb(17 150 147 / 0.15);
  }

  .tv__progress span {
    display: block;
    height: 100%;
    background: var(--turquoise);
    transform-origin: left;
    transform: scaleX(0);
  }

  @media (max-height: 47.5rem) {
    .tv.is-live .tv__head .lede {
      display: none;
    }
  }

  @media (max-width: 44.99rem) {
    .tv.is-live {
      --tv-len: 3.2;
    }

    .tv.is-live .tv__layer--2 {
      display: none;
    }

    .tv.is-live .tv__layer--0 .tv__item {
      width: 58vw;
    }

    .tv.is-live .tv__layer--1 .tv__item {
      width: 34vw;
    }

    .tv.is-live .tv__head .lede {
      display: none;
    }
  }
</style>
