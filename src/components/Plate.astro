---
/**
 * « Planche » éditoriale : affiche la photo associée à un emplacement du registre
 * (src/content/photos.ts) ou, à défaut, une composition graphique originale.
 * Jamais de fausse photo, jamais de mention « image à venir » en public.
 */
import { Picture } from 'astro:assets';
import { PHOTO_SLOTS, altFor, creditFor, focusFor, photoFor, type PhotoSlotId, type PlateMotif } from '~/content/photos';
import { focusClass } from '~/lib/library';
import PlateArt from './PlateArt.astro';

interface Props {
  id: PhotoSlotId;
  class?: string;
  /** Ratio imposé (sinon celui du registre). */
  ratio?: number;
  /** Image prioritaire (premier écran). */
  priority?: boolean;
  sizes?: string;
  shape?: 'rect' | 'arch' | 'round';
  reveal?: boolean;
}

const { id, class: className, ratio: forcedRatio, priority = false, sizes = '(min-width: 64rem) 45vw, 92vw', shape = 'rect', reveal = true } = Astro.props;
const slot = PHOTO_SLOTS[id];
const ratio = forcedRatio ?? slot.ratio;
const photo = photoFor(id);
// Ratio exprimé en attribut (et non en style inline) pour rester compatible avec la CSP.
const RATIOS: Record<string, number> = { '4-5': 4 / 5, '3-4': 3 / 4, '4-3': 4 / 3, '3-2': 3 / 2, '1-1': 1 };
const ratioKey = Object.entries(RATIOS).reduce((best, [key, value]) => (Math.abs(value - ratio) < Math.abs(RATIOS[best]! - ratio) ? key : best), '4-5');
const credit = creditFor(id);
const focus = focusFor(id);
const motif: PlateMotif = slot.motif;
---
<figure
  class:list={['plate', `plate--${shape}`, `plate--${motif}`, reveal && 'reveal-mask reveal-scale', focus && focusClass({ focus }), className]}
  data-ratio={ratioKey}
  data-photo-slot={id}
  data-has-photo={photo ? 'true' : 'false'}
>
  {
    photo ? (
      <Picture
        src={photo}
        alt={altFor(id)}
        formats={['avif', 'webp']}
        widths={[480, 800, 1200, 1600]}
        sizes={sizes}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        class="plate__img"
      />
    ) : (
      <PlateArt motif={motif} class="plate__art" />
    )
  }
  {
    photo && credit && !credit.authentic && (
      <figcaption class="plate__credit">
        Photo d’illustration : <a href={credit.sourceUrl} rel="noopener">{credit.author}</a>, {credit.licenceUrl ? <a href={credit.licenceUrl} rel="license noopener">{credit.licence}</a> : credit.licence}
      </figcaption>
    )
  }
  <slot />
</figure>

<style>
  .plate {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-l);
    background: var(--lin);
    isolation: isolate;
  }

  .plate[data-ratio='3-4'] {
    aspect-ratio: 3 / 4;
  }

  .plate[data-ratio='4-3'] {
    aspect-ratio: 4 / 3;
  }

  .plate[data-ratio='3-2'] {
    aspect-ratio: 3 / 2;
  }

  .plate[data-ratio='1-1'] {
    aspect-ratio: 1;
  }

  .plate--arch {
    border-radius: var(--radius-arch);
  }

  .plate--round {
    border-radius: 50%;
  }

  .plate :global(.plate__art),
  .plate :global(.plate__img),
  .plate :global(picture) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .plate :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--fx, 50%) var(--fy, 50%);
  }


  .plate__credit {
    position: absolute;
    right: var(--space-xs);
    bottom: var(--space-xs);
    padding: 0.15em 0.6em;
    border-radius: var(--radius-pill);
    background: rgb(11 21 20 / 0.7);
    color: var(--craie);
    font-size: 0.72rem;
    max-width: calc(100% - 2 * var(--space-xs));
  }

  .plate__credit a {
    color: inherit;
  }
</style>
