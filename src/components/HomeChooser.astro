---
/**
 * « Où en êtes-vous avec votre chien ? » — sélecteur en constellation.
 * Le visiteur choisit sa situation : un trait de lumière part de « vous » vers l'étoile choisie,
 * et le chemin d'accompagnement correspondant se révèle. Sans JavaScript, les quatre chemins
 * sont listés. Fonctionne au clavier (flèches), au toucher et à la souris.
 */
import Icon from './Icon.astro';
import PlateArt from './PlateArt.astro';
import { ACCOMPAGNEMENTS } from '~/content/accompagnements';

const OPTIONS: Record<string, { choice: string; stage: string; x: number; y: number }> = {
  chiot: { choice: 'Un chiot arrive, ou vient d’arriver', stage: 'chiot-arrive', x: 190, y: 120 },
  'chien-adulte': { choice: 'Un chien adulte partage notre vie', stage: 'adopte', x: 400, y: 70 },
  quotidien: { choice: 'Une situation du quotidien nous pèse', stage: 'installe', x: 520, y: 250 },
  comprendre: { choice: 'Nous aimerions simplement mieux le comprendre', stage: 'installe', x: 330, y: 300 },
};
const ME = { x: 70, y: 420 };
const items = ACCOMPAGNEMENTS.map((a) => ({ a, ...OPTIONS[a.slug]! }));
const curve = (x: number, y: number) => `M${ME.x} ${ME.y} Q ${(ME.x + x) / 2 - 40} ${(ME.y + y) / 2 - 90} ${x} ${y}`;
---
<section class="ch on-dark" aria-labelledby="ch-title" data-chooser data-sky="1.4">
  <div class="page ch__grid">
    <div class="ch__intro">
      <p class="eyebrow">Quatre chemins</p>
      <h2 id="ch-title">Où en êtes-vous <em>avec votre chien</em>&nbsp;?</h2>
      <p class="lede">Choisissez ce qui vous ressemble aujourd’hui&nbsp;: le chemin d’accompagnement le plus proche s’éclaire.</p>
      <div class="ch__options" role="radiogroup" aria-labelledby="ch-title" data-ch-options>
        {
          items.map(({ a, choice }, i) => (
            <button type="button" class="ch__option" role="radio" aria-checked="false" tabindex={i === 0 ? 0 : -1} data-ch-pick={a.slug}>
              <span class="ch__num" aria-hidden="true">{a.num}</span>
              <span>{choice}</span>
            </button>
          ))
        }
      </div>
    </div>

    <div class="ch__stage">
      <svg class="ch__sky" viewBox="0 0 600 480" aria-hidden="true" focusable="false">
        <defs>
          <radialGradient id="ch-glow">
            <stop offset="0%" stop-color="#dff3ef" stop-opacity="0.9" />
            <stop offset="45%" stop-color="#9ad3cd" stop-opacity="0.35" />
            <stop offset="100%" stop-color="#119693" stop-opacity="0" />
          </radialGradient>
        </defs>
        <polyline class="ch__web" points={items.map((i) => `${i.x},${i.y}`).join(' ') + ` ${items[0]!.x},${items[0]!.y}`} />
        {items.map((i) => <path class="ch__ray" data-ch-ray={i.a.slug} d={curve(i.x, i.y)} pathLength="1" />)}
        <g class="ch__me">
          <circle cx={ME.x} cy={ME.y} r="26" fill="url(#ch-glow)" />
          <circle cx={ME.x} cy={ME.y} r="4.5" class="ch__core" />
          <text x={ME.x + 16} y={ME.y + 28} class="ch__label">vous</text>
        </g>
        {
          items.map((i) => (
            <g class="ch__star" data-ch-star={i.a.slug}>
              <circle cx={i.x} cy={i.y} r="34" fill="url(#ch-glow)" class="ch__halo" />
              <circle cx={i.x} cy={i.y} r="5" class="ch__core" />
              <text x={i.x + 14} y={i.y - 12} class="ch__label">{i.a.num}</text>
            </g>
          ))
        }
      </svg>

      <div class="ch__panels">
        <div class="ch__panel ch__panel--invite" data-ch-panel="">
          <p class="label">Votre chemin</p>
          <p class="ch__invite">Sélectionnez une situation pour voir le chemin qui s’en approche le plus.</p>
        </div>
        {
          items.map(({ a, stage }) => (
            <article class="ch__panel" data-ch-panel={a.slug} aria-labelledby={`ch-${a.slug}`}>
              <span class="ch__art" aria-hidden="true"><PlateArt motif={a.motif} /></span>
              <div class="ch__body">
                <p class="label">Chemin {a.num}</p>
                <h3 id={`ch-${a.slug}`}>{a.label}</h3>
                <p>{a.short}</p>
                <ul role="list">{a.repères.map((r) => <li>{r.title}</li>)}</ul>
                <div class="ch__links">
                  <a class="btn btn--lagon btn--sm" href={`/accompagnements/${a.slug}/`}>Explorer ce chemin <Icon name="arrow" class="btn__arrow" /></a>
                  <a class="link-arrow" href={`/orientation/?stage=${stage}`}>Affiner en quatre questions <Icon name="arrow" /></a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-chooser]').forEach((root) => {
    const options = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-ch-pick]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-ch-panel]'));
    root.classList.add('is-live');
    const pick = (slug: string, focus = false) => {
      root.dataset.choice = slug;
      options.forEach((o) => {
        const on = o.dataset.chPick === slug;
        o.setAttribute('aria-checked', String(on));
        o.tabIndex = on ? 0 : -1;
        if (on && focus) o.focus();
      });
      root.querySelectorAll<SVGElement>('[data-ch-ray]').forEach((r) => r.classList.toggle('is-on', r.dataset.chRay === slug));
      root.querySelectorAll<SVGElement>('[data-ch-star]').forEach((s) => s.classList.toggle('is-on', s.dataset.chStar === slug));
      panels.forEach((p) => p.classList.toggle('is-on', p.dataset.chPanel === slug));
    };
    options.forEach((o, i) => {
      o.addEventListener('click', () => pick(o.dataset.chPick!));
      o.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        pick(options[(i + d + options.length) % options.length]!.dataset.chPick!, true);
      });
    });
    root.querySelectorAll<SVGElement>('[data-ch-star]').forEach((s) => s.addEventListener('click', () => pick(s.dataset.chStar!)));
    panels.find((p) => p.dataset.chPanel === '')?.classList.add('is-on');
  });
</script>

<style>
  .ch {
    padding-block: var(--space-2xl);
    background: radial-gradient(70% 60% at 75% 40%, #12302d, var(--nuit) 70%);
    overflow: hidden;
  }

  .ch__grid {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  @media (min-width: 64rem) {
    .ch__grid {
      grid-template-columns: 5fr 7fr;
    }
  }

  .ch__intro {
    display: grid;
    gap: var(--space-m);
  }

  .ch__intro h2 em {
    color: var(--lagon);
  }

  .ch__options {
    display: grid;
    gap: 0.5rem;
    margin-top: var(--space-s);
  }

  .ch__option {
    display: grid;
    grid-template-columns: 2.4rem 1fr;
    gap: var(--space-s);
    align-items: center;
    min-height: 3.4rem;
    padding: 0.7rem 1rem;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: var(--radius-m);
    background: rgb(255 255 255 / 0.02);
    color: var(--craie);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: border-color var(--dur) ease, background-color var(--dur) ease, transform var(--dur) var(--ease-out);
  }

  .ch__option:hover {
    border-color: rgb(154 211 205 / 0.5);
    transform: translateX(4px);
  }

  .ch__option[aria-checked='true'] {
    border-color: var(--lagon);
    background: rgb(154 211 205 / 0.1);
  }

  .ch__option:focus-visible {
    outline: 3px solid var(--lagon);
    outline-offset: 2px;
  }

  .ch__num {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--lagon);
  }

  .ch__stage {
    display: grid;
    gap: var(--space-m);
  }

  @media (min-width: 64rem) {
    .ch__stage {
      grid-template-areas: 'stack';
    }

    .ch__sky,
    .ch__panels {
      grid-area: stack;
    }

    .ch__panels {
      align-self: end;
      justify-self: end;
      width: min(26rem, 70%);
    }
  }

  .ch__sky {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .ch__web {
    fill: none;
    stroke: rgb(154 211 205 / 0.16);
    stroke-width: 1;
    stroke-dasharray: 3 6;
  }

  .ch__ray {
    fill: none;
    stroke: var(--lagon);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0;
    filter: drop-shadow(0 0 6px rgb(154 211 205 / 0.7));
    transition: stroke-dashoffset 1.1s var(--ease-out), opacity 300ms ease;
  }

  .ch__ray.is-on {
    stroke-dashoffset: 0;
    opacity: 1;
  }

  .ch__core {
    fill: var(--lueur);
  }

  .ch__label {
    fill: var(--craie-douce);
    font: 500 13px var(--font-mono);
    letter-spacing: 0.08em;
  }

  .ch__star {
    cursor: pointer;
    transform-box: fill-box;
    transform-origin: center;
    transition: opacity 500ms ease;
  }

  .ch__halo {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 700ms var(--ease-out);
  }

  /* Respiration autonome des étoiles. */
  @media (prefers-reduced-motion: no-preference) {
    .ch__halo {
      animation: ch-breathe 5s ease-in-out infinite;
    }

    .ch__star:nth-of-type(2n) .ch__halo {
      animation-duration: 6.5s;
      animation-delay: -2s;
    }
  }

  @keyframes ch-breathe {
    50% {
      transform: scale(1.25);
      opacity: 0.6;
    }
  }

  [data-choice] .ch__star:not(.is-on) {
    opacity: 0.45;
  }

  .ch__star.is-on .ch__halo {
    animation: none;
    transform: scale(1.7);
  }

  .ch__panels {
    display: grid;
  }

  .ch__panel {
    display: grid;
    gap: var(--space-s);
    padding: var(--space-m);
    border-radius: var(--radius-l);
    background: rgb(11 21 20 / 0.86);
    border: 1px solid rgb(255 255 255 / 0.1);
    backdrop-filter: blur(10px);
  }

  .ch__panel--invite {
    display: none;
  }

  .is-live .ch__panels {
    grid-template-areas: 'stack';
  }

  .is-live .ch__panel {
    grid-area: stack;
    opacity: 0;
    visibility: hidden;
    transform: translateY(1rem);
    transition: opacity 500ms var(--ease-out), transform 600ms var(--ease-out), visibility 0s 500ms;
  }

  .is-live .ch__panel--invite {
    display: grid;
    align-content: center;
  }

  .is-live .ch__panel.is-on {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 250ms, 250ms, 0s;
  }

  /* Sans JavaScript : la liste des chemins reste lisible. */
  .ch:not(.is-live) .ch__panels {
    gap: var(--space-s);
  }

  .ch__invite {
    color: var(--craie-douce);
  }

  .ch__panel:not(.ch__panel--invite) {
    grid-template-columns: 6.5rem 1fr;
    align-items: start;
  }

  .ch__art {
    position: relative;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-arch);
    overflow: hidden;
  }

  .ch__art :global(.plate-art) {
    position: absolute;
    inset: 0;
  }

  .ch__body {
    display: grid;
    gap: var(--space-2xs);
  }

  .ch__body h3 {
    font-size: var(--step-2);
  }

  .ch__body > p:not(.label) {
    color: var(--craie-douce);
    font-size: var(--step--1);
  }

  .ch__body ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding: 0;
    list-style: none;
  }

  .ch__body li {
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill);
    border: 1px solid rgb(154 211 205 / 0.3);
    font-size: var(--step--2);
    color: var(--lagon-clair);
  }

  .ch__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    align-items: center;
    margin-top: var(--space-2xs);
  }

  @media (max-width: 40rem) {
    .ch__panel:not(.ch__panel--invite) {
      grid-template-columns: 1fr;
    }

    .ch__art {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ch__ray,
    .is-live .ch__panel {
      transition: none;
    }
  }
</style>
