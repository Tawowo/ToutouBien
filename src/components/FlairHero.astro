---
/**
 * Scène d'ouverture « Le flair ».
 * Trois modes :
 * - statique (par défaut, sans JS, mouvement réduit, appareil modeste) : l'emblème
 *   dessiné en SVG et les chapitres affichés à la suite ;
 * - cinéma (WebGL disponible) : section collante de 3,2 écrans ; les particules
 *   composent la rencontre, la balade puis le lien, et les textes suivent la même
 *   progression lissée (scripts/flair/timeline.ts) ;
 * - repli automatique vers le mode statique si l'appareil ne tient pas la cadence.
 * Le texte est toujours du HTML réel, lisible par tous et indexable.
 */
import Icon from './Icon.astro';
import SplitTitle from './SplitTitle.astro';
import emblemRaw from '~/assets/brand/emblem.svg?raw';
import { site } from '~/config/site';

const d = emblemRaw.match(/ d="([^"]+)"/)?.[1] ?? '';
const viewBox = emblemRaw.match(/viewBox="([^"]+)"/)?.[1] ?? '0 0 1080 1010';

---
<section class="cine on-dark" data-cine data-mode="static" data-chapter="0" aria-labelledby="cine-title">
  <div class="cine__sticky">
    <div class="cine__glow" aria-hidden="true"></div>
    <canvas class="cine__canvas" aria-hidden="true"></canvas>
    <svg class="cine__static" viewBox={viewBox} aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="cine-grad" x1="0" y1="0" x2="0.4" y2="1">
          <stop offset="0%" stop-color="#cfeae6" />
          <stop offset="55%" stop-color="#9ad3cd" />
          <stop offset="100%" stop-color="#119693" />
        </linearGradient>
      </defs>
      <path d={d} fill="url(#cine-grad)" fill-rule="evenodd" data-emblem-path />
    </svg>

    <div class="cine__block cine__intro page" data-block="intro">
      <p class="eyebrow enter">Éducation canine · accompagnement des familles</p>
      <SplitTitle as="h1" id="cine-title" class="cine__title" text="Comprendre son chien, *se sentir bien* ensemble." now />
      <p class="lede cine__lede enter" data-i="4">
        ToutouBien accompagne les propriétaires et leur chien pour que le quotidien redevienne plus simple, à la maison comme en balade.
      </p>
      <div class="cine__actions enter" data-i="5">
        <a class="btn btn--lagon" href="/parlons-de-votre-chien/" data-magnetic>
          Parlons de votre chien
          <Icon name="arrow" class="btn__arrow" />
        </a>
        <a class="cine__secondary" href="/orientation/">Par où commencer&nbsp;?</a>
      </div>
    </div>

    <div class="cine__chapters page">
      <div class="cine__block cine__chapter" data-block="walk">
        <p class="label">Chapitre 02 · La balade</p>
        <h2 class="cine__chapter-title">Dehors, <em>il lit le monde</em> avec son nez.</h2>
        <p>Comprendre ce que votre chien perçoit change la façon de marcher ensemble.</p>
        <a class="link-arrow" href="/explorer/flair/">Essayer : le monde par le nez <Icon name="arrow" /></a>
      </div>
      <div class="cine__block cine__chapter" data-block="link">
        <p class="label">Chapitre 03 · Le lien</p>
        <h2 class="cine__chapter-title">Apprendre <em>à se lire</em>, l’un l’autre.</h2>
        <p>Un accompagnement qui part de votre quotidien, pour une relation qui fait du bien à chacun.</p>
        <a class="link-arrow" href="/approche/">Découvrir l’approche <Icon name="arrow" /></a>
      </div>
    </div>

    <div class="cine__rail" aria-hidden="true">
      <span class="cine__rail-fill"></span>
      <span class="cine__rail-label">Défilez</span>
    </div>
    <p class="cine__signature" aria-hidden="true">{site.tagline.value}</p>
  </div>
</section>

<script>
  import { initFlairHero } from '~/scripts/flair/hero';
  initFlairHero();
</script>

<style>
  .cine {
    position: relative;
    z-index: 1;
    background:
      radial-gradient(80% 60% at 70% 35%, #15302d 0%, var(--nuit) 70%),
      var(--nuit);
  }

  .cine__sticky {
    position: relative;
    display: grid;
    gap: var(--space-xl);
    min-height: min(100svh - 4.75rem, 60rem);
    padding-block: var(--space-xl);
    overflow: hidden;
    isolation: isolate;
  }

  .cine__glow {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(38% 34% at 72% 44%, rgb(17 150 147 / 0.2), transparent 70%),
      radial-gradient(30% 30% at 18% 82%, rgb(154 211 205 / 0.06), transparent 70%);
  }

  .cine__canvas {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 900ms var(--ease-out);
  }

  /* Mode statique : grille texte + emblème, chapitres en dessous ; rien ne se chevauche. */
  .cine__static {
    grid-area: art;
    justify-self: center;
    align-self: center;
    width: min(100%, 30rem);
    height: auto;
    filter: drop-shadow(0 0 2.5rem rgb(17 150 147 / 0.35));
    transition: opacity 900ms var(--ease-out);
  }

  .cine[data-mode='static'] .cine__sticky {
    grid-template-areas: 'art' 'intro' 'chapters';
    width: var(--page);
    margin-inline: auto;
  }

  .cine[data-mode='static'] .cine__intro,
  .cine[data-mode='static'] .cine__chapters {
    width: auto;
    margin: 0;
  }

  .cine[data-mode='static'] .cine__intro {
    grid-area: intro;
  }

  .cine[data-mode='static'] .cine__chapters {
    grid-area: chapters;
  }

  .cine[data-mode='static'] .cine__static {
    width: min(70%, 18rem);
    justify-self: end;
  }

  @media (min-width: 60rem) {
    .cine[data-mode='static'] .cine__sticky {
      grid-template-columns: 7fr 5fr;
      grid-template-areas: 'intro art' 'chapters chapters';
      column-gap: var(--space-xl);
    }

    .cine[data-mode='static'] .cine__static {
      width: min(100%, 30rem);
      justify-self: center;
    }
  }

  .cine__intro {
    display: grid;
    gap: var(--space-m);
    align-content: center;
    justify-items: start;
  }

  .cine__title {
    max-width: 12ch;
    font-size: clamp(2.6rem, 1.3rem + 4.4vw, 5.8rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
  }

  .cine__title :global(em) {
    color: var(--lagon);
  }

  .cine__lede {
    max-width: 36ch;
  }

  .cine__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    align-items: center;
  }

  .cine__secondary {
    padding-block: 0.6rem;
    font-weight: 600;
  }

  .cine__chapters {
    display: grid;
    gap: var(--space-l);
  }

  @media (min-width: 48rem) {
    .cine__chapters {
      grid-template-columns: repeat(2, minmax(0, 30rem));
    }
  }

  .cine__chapter {
    display: grid;
    gap: var(--space-s);
    justify-items: start;
    align-content: start;
    padding-top: var(--space-s);
    border-top: 1px solid rgb(255 255 255 / 0.16);
  }

  .cine__chapter-title {
    font-size: clamp(1.9rem, 1.3rem + 2.4vw, 3.6rem);
    line-height: 1;
    max-width: 16ch;
  }

  .cine__chapter-title em {
    color: var(--lagon);
  }

  .cine__chapter p:not(.label) {
    max-width: 36ch;
    color: var(--craie-douce);
  }

  .cine__rail,
  .cine__signature {
    display: none;
  }

  /* ============ Mode cinéma ============ */
  .cine[data-mode='cinema'] {
    height: 320svh;
  }

  .cine[data-mode='cinema'] .cine__sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 0;
    padding-block: 0;
  }

  .cine[data-ready='true'] .cine__canvas {
    opacity: 1;
  }

  .cine[data-mode='cinema'] .cine__static {
    position: absolute;
    z-index: -1;
    right: 6%;
    top: 50%;
    width: min(36vw, 30rem);
    transform: translateY(-50%);
  }

  .cine[data-ready='true'] .cine__static {
    opacity: 0;
  }

  /* Chaque bloc suit la progression lissée (--a), exactement comme les particules. */
  .cine[data-mode='cinema'] .cine__block {
    --a: 0;
    opacity: var(--a);
    transform: translate3d(0, calc((1 - var(--a)) * 1.5rem), 0);
    will-change: opacity, transform;
  }

  .cine[data-mode='cinema'] .cine__intro {
    --a: 1;
    position: absolute;
    inset: 0;
    padding-top: 4.75rem;
  }

  .cine[data-mode='cinema'] .cine__chapters {
    position: absolute;
    inset: auto 0 13svh 0;
    margin: 0 auto;
    display: block;
  }

  .cine[data-mode='cinema'] .cine__chapter {
    position: absolute;
    left: 0;
    bottom: 0;
    width: min(31rem, 100%);
    border-top: 0;
    padding-top: 0;
  }

  .cine[data-mode='cinema'] .cine__chapter-title {
    font-size: clamp(2.2rem, 1.3rem + 3vw, 4.4rem);
  }

  .cine[data-mode='cinema'] .cine__rail {
    display: block;
    position: absolute;
    right: var(--gutter);
    top: 50%;
    width: 1px;
    height: 26svh;
    transform: translateY(-50%);
    background: rgb(255 255 255 / 0.14);
  }

  .cine__rail-fill {
    position: absolute;
    inset: 0 0 auto 0;
    height: calc(var(--p, 0) * 100%);
    background: var(--lagon);
  }

  .cine__rail-label {
    position: absolute;
    top: calc(100% + 0.8rem);
    left: 50%;
    transform: translateX(-50%) rotate(90deg);
    transform-origin: left center;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--craie-douce);
    white-space: nowrap;
  }

  .cine[data-mode='cinema'] .cine__signature {
    display: block;
    position: absolute;
    right: calc(var(--gutter) + 2rem);
    bottom: var(--space-m);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-0);
    color: var(--craie-douce);
  }

  @media (max-width: 59.99rem) {
    .cine[data-mode='cinema'] .cine__static {
      top: 9%;
      right: 50%;
      width: min(62vw, 17rem);
      transform: translateX(50%);
    }

    .cine[data-mode='cinema'] .cine__intro > .eyebrow {
      display: none;
    }

    .cine[data-mode='cinema'] .cine__intro {
      align-content: end;
      gap: var(--space-s);
      padding-bottom: 6svh;
      background: linear-gradient(to top, rgb(11 21 20 / 0.94) 42%, rgb(11 21 20 / 0.55) 60%, transparent 76%);
    }

    .cine[data-mode='cinema'] .cine__rail,
    .cine[data-mode='cinema'] .cine__signature {
      display: none;
    }

    .cine[data-mode='cinema'] .cine__chapters {
      bottom: 7svh;
    }

    .cine[data-mode='cinema'] .cine__chapter {
      padding: var(--space-m);
      border-radius: var(--radius-l);
      background: rgb(11 21 20 / 0.78);
      backdrop-filter: blur(8px);
    }
  }
</style>
