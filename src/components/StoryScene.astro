---
/** Scènes illustrées (SVG) du récit en étapes. Décoratives. */
import emblemRaw from '~/assets/brand/emblem.svg?raw';

interface Props {
  scene: 'demande' | 'echange' | 'clarifier' | 'organiser' | 'suite';
  index: number;
  inline?: boolean;
}
const { scene, index, inline = false } = Astro.props;
const emblem = emblemRaw.match(/ d="([^"]+)"/)?.[1] ?? '';
const dots = Array.from({ length: 22 }, (_, i) => ({ x: 120 + ((i * 97) % 360), y: 110 + ((i * 53) % 190), r: 3 + (i % 3) }));
---
<svg class:list={['scene', `scene--${scene}`, inline && 'scene--inline']} data-index={index} viewBox="0 0 600 450" preserveAspectRatio="xMidYMid slice">
  <rect width="600" height="450" fill="#0b1514" />
  {
    scene === 'demande' && (
      <g class="s-demande">
        <rect x="200" y="70" width="200" height="320" rx="28" fill="#132220" stroke="#9ad3cd" stroke-width="2" />
        <rect x="222" y="110" width="156" height="10" rx="5" fill="#9ad3cd" opacity="0.5" />
        {[0, 1, 2, 3].map((k) => (
          <g class="s-demande__row" data-k={k}>
            <circle cx="236" cy={160 + k * 46} r="9" fill="none" stroke="#dff3ef" stroke-width="2" />
            <path d={`M231 ${160 + k * 46} l4 4 l8 -9`} fill="none" stroke="#dff3ef" stroke-width="2.5" stroke-linecap="round" class="s-check" />
            <rect x="256" y={155 + k * 46} width={100 - k * 14} height="9" rx="4.5" fill="#eef4f2" opacity="0.35" />
          </g>
        ))}
        <path d="M400 300 C 470 300 500 250 520 200" fill="none" stroke="#dff3ef" stroke-width="2" stroke-dasharray="6 8" class="s-fil" />
        <circle cx="520" cy="200" r="8" fill="#dff3ef" />
      </g>
    )
  }
  {
    scene === 'echange' && (
      <g class="s-echange">
        <svg x="60" y="40" width="480" height="380" viewBox="150 110 800 620">
          <path d={emblem} fill="#9ad3cd" fill-rule="evenodd" />
        </svg>
        <circle cx="300" cy="190" r="70" fill="#dff3ef" opacity="0.12" class="s-glow" />
      </g>
    )
  }
  {
    scene === 'clarifier' && (
      <g class="s-clarifier">
        {dots.map((d, i) => (
          <circle cx={d.x} cy={d.y} r={d.r} fill={i % 4 === 0 ? '#dff3ef' : '#9ad3cd'} opacity="0.7" />
        ))}
        <g class="s-lens">
          <circle cx="300" cy="215" r="90" fill="#9ad3cd" opacity="0.08" stroke="#eef4f2" stroke-width="3" />
          <path d="M364 279 L 430 345" stroke="#eef4f2" stroke-width="10" stroke-linecap="round" />
          <path d="M250 200 h 100 M 250 225 h 70 M 250 250 h 85" stroke="#dff3ef" stroke-width="4" stroke-linecap="round" />
        </g>
      </g>
    )
  }
  {
    scene === 'organiser' && (
      <g class="s-organiser">
        <path d="M60 380 C 160 300 120 220 240 210 S 380 300 440 200 S 520 90 560 70" fill="none" stroke="#c7d7d3" stroke-width="22" stroke-linecap="round" opacity="0.18" />
        <path d="M60 380 C 160 300 120 220 240 210 S 380 300 440 200 S 520 90 560 70" fill="none" stroke="#dff3ef" stroke-width="2.5" class="s-route" pathLength="1" />
        {[[110, 330], [240, 210], [370, 250], [470, 150], [560, 70]].map(([x, y], i) => (
          <g>
            <circle cx={x} cy={y} r="13" fill="#0b1514" stroke="#9ad3cd" stroke-width="2.5" />
            <text x={x} y={(y as number) + 5} text-anchor="middle" font-family="DM Mono, monospace" font-size="13" fill="#9ad3cd">{i + 1}</text>
          </g>
        ))}
      </g>
    )
  }
  {
    scene === 'suite' && (
      <g class="s-suite">
        <circle cx="300" cy="300" r="90" fill="#dff3ef" opacity="0.85" class="s-sun" />
        <path d="M0 300 C 120 280 220 296 300 288 S 500 270 600 282 V450 H0Z" fill="#132220" />
        <path d="M0 340 C 160 326 320 350 600 330" fill="none" stroke="#9ad3cd" stroke-width="1.5" opacity="0.6" />
        <path d="M300 240 C 300 210 340 196 360 220 C 380 196 420 210 420 240 C 420 270 380 290 360 310 C 340 290 300 270 300 240 Z" transform="translate(-60 -150)" fill="none" stroke="#9ad3cd" stroke-width="3" class="s-heart" pathLength="1" />
      </g>
    )
  }
</svg>

<style>
  .scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .s-glow {
      animation: glow 3s ease-in-out infinite alternate;
    }

    .s-lens {
      animation: lens 6s ease-in-out infinite alternate;
    }

    .s-route,
    .s-heart {
      stroke-dasharray: 1;
      animation: draw 3s var(--ease-in-out) infinite alternate;
    }

    .s-sun {
      animation: rise 4s var(--ease-out) infinite alternate;
    }

    .s-fil {
      animation: dash 2s linear infinite;
    }
  }

  @keyframes glow {
    to {
      opacity: 0.3;
      transform: scale(1.15);
      transform-origin: 300px 190px;
    }
  }

  @keyframes lens {
    to {
      transform: translate(40px, -20px);
    }
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }

    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes rise {
    from {
      transform: translateY(30px);
    }

    to {
      transform: translateY(-10px);
    }
  }

  @keyframes dash {
    to {
      stroke-dashoffset: -28;
    }
  }
</style>
