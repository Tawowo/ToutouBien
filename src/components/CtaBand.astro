---
import Icon from './Icon.astro';
import Fil from './Fil.astro';
import EmblemRaw from '~/assets/brand/emblem.svg';

interface Props {
  title?: string;
  text?: string;
  href?: string;
  label?: string;
}
const {
  title = 'Et si l’on commençait par en parler ?',
  text = 'Quelques questions simples, deux minutes, et vous serez recontacté·e pour échanger sur votre chien.',
  href = '/parlons-de-votre-chien/',
  label = 'Parlons de votre chien',
} = Astro.props;
---
<section class="cta-band on-dark" aria-labelledby="cta-band-title">
  <EmblemRaw class="cta-band__emblem" aria-hidden="true" />
  <Fil variant="boucle" class="cta-band__fil" />
  <div class="page cta-band__inner">
    <h2 id="cta-band-title" class="reveal" set:html={title} />
    <p class="lede reveal">{text}</p>
    <a class="btn btn--lagon reveal" href={href}>
      {label}
      <Icon name="arrow" class="btn__arrow" />
    </a>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-2xl);
    isolation: isolate;
  }

  .cta-band__emblem {
    position: absolute;
    right: -8%;
    bottom: -22%;
    width: min(46rem, 80vw);
    height: auto;
    color: var(--nuit-2);
    z-index: -1;
  }

  .cta-band__fil {
    position: absolute;
    right: 0;
    bottom: 8%;
    width: min(44rem, 60vw);
    height: auto;
    color: var(--lagon-clair);
    opacity: 0.6;
    z-index: -1;
  }

  @media (max-width: 59.99rem) {
    .cta-band__fil {
      display: none;
    }
  }

  .cta-band__inner {
    display: grid;
    justify-items: start;
    gap: var(--space-m);
  }

  .cta-band h2 {
    max-width: 14ch;
    font-size: var(--step-5);
  }

  .cta-band .lede {
    max-width: 44ch;
  }
</style>
