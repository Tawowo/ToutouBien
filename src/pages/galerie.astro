---
/**
 * La galerie. Trois familles d'images, toujours distinguées :
 *  1. les photos authentiques de l'activité (src/assets/photos/galerie/ + galerie.json) ;
 *  2. les photographies d'illustration libres de droits, créditées, jamais présentées comme des chiens accompagnés ;
 *  3. le carnet graphique : les compositions originales de ToutouBien.
 * Toutes s'ouvrent dans la même visionneuse accessible.
 */
import type { ImageMetadata } from 'astro';
import { Picture, getImage } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import SplitTitle from '~/components/SplitTitle.astro';
import PlateArt from '~/components/PlateArt.astro';
import Draft from '~/components/Draft.astro';
import Icon from '~/components/Icon.astro';
import meta from '~/content/galerie.json';
import { PHOTO_SLOTS, creditFor, photoFor, type PhotoSlot, type PlateMotif } from '~/content/photos';
import { draftsVisible } from '~/lib/fields';

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/galerie/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const info = meta as Record<string, { alt?: string; legende?: string }>;
const authentic = await Promise.all(
  Object.entries(files)
    .map(([path, mod]) => ({ name: path.split('/').pop()!, img: mod.default, ...info[path.split('/').pop()!] }))
    .filter((p): p is typeof p & { alt: string } => typeof p.alt === 'string' && p.alt.trim().length > 0)
    .map(async (p) => ({ ...p, full: (await getImage({ src: p.img, width: 1800, format: 'webp' })).src })),
);

const illustrative = await Promise.all(
  (Object.values(PHOTO_SLOTS) as PhotoSlot[])
    .filter((s) => s.illustrative)
    .map((s) => ({ slot: s, img: photoFor(s.id), credit: creditFor(s.id) }))
    .filter((p): p is typeof p & { img: ImageMetadata } => p.img !== undefined)
    .map(async (p) => ({ ...p, full: (await getImage({ src: p.img, width: 1800, format: 'webp' })).src })),
);

const ART: { motif: PlateMotif; title: string; text: string }[] = [
  { motif: 'chemin', title: 'Le chemin', text: 'Avancer à deux, chacun à son rythme.' },
  { motif: 'rencontre', title: 'La rencontre', text: 'Le moment où l’on commence à se comprendre.' },
  { motif: 'herbes', title: 'Les herbes hautes', text: 'Le monde des odeurs, à hauteur de truffe.' },
  { motif: 'horizon', title: 'L’horizon', text: 'Le calme qui revient, en fin de balade.' },
  { motif: 'portrait', title: 'Le portrait', text: 'L’emblème de ToutouBien, tracé d’un seul trait.' },
];
const preprod = draftsVisible();
const SLOTS = ['Mme Petitgand et son chien', 'Une séance en extérieur', 'Une balade en groupe', 'Le lieu de travail', 'Un moment de complicité', 'Le matériel utilisé'];
---
<Base title="Galerie" description="La galerie ToutouBien : des instants en images, des photographies d’illustration créditées et le carnet graphique de la marque.">
  <section class="gh" data-sky="0.45">
    <div class="page gh__inner">
      <p class="eyebrow enter">Galerie</p>
      <SplitTitle as="h1" text="Des instants, *en images*." now />
      <p class="lede enter" data-i="3">Les photographies de l’activité sont publiées uniquement avec l’accord des familles. Les photographies d’illustration, libres de droits et créditées, ne montrent pas de chiens accompagnés par ToutouBien.</p>
    </div>
  </section>

  {
    (authentic.length > 0 || preprod) && (
      <section class="section section--tight" aria-labelledby="g-auth">
        <div class="page">
          <header class="g-head">
            <h2 id="g-auth">L’activité <em>au quotidien</em></h2>
            <p class="label">Photos authentiques</p>
          </header>
          {authentic.length > 0 ? (
            <ul class="g-grid" role="list">
              {authentic.map((p, i) => (
                <li class:list={['g-item', 'reveal', i % 6 === 0 && 'g-item--tall', i % 6 === 3 && 'g-item--wide']}>
                  <button type="button" class="g-thumb" data-lb data-lb-full={p.full} data-lb-alt={p.alt} data-lb-caption={p.legende ?? p.alt} aria-label={`Agrandir : ${p.legende ?? p.alt}`}>
                    <Picture src={p.img} alt="" formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes="(min-width: 60rem) 33vw, 92vw" loading="lazy" />
                  </button>
                  {p.legende && <p class="g-cap">{p.legende}</p>}
                </li>
              ))}
            </ul>
          ) : (
            <Draft label="Photos à fournir">
              <p>Emplacements prévus pour les photos de Mme Petitgand (déposer les fichiers dans <code>src/assets/photos/galerie/</code> et leurs légendes dans <code>src/content/galerie.json</code>). Ce bloc n’apparaît pas en production.</p>
              <ul class="g-grid g-grid--slots" role="list">
                {SLOTS.map((s, i) => (
                  <li class:list={['g-slot', i % 6 === 0 && 'g-item--tall', i % 6 === 3 && 'g-item--wide']}>
                    <span>{s}</span>
                  </li>
                ))}
              </ul>
            </Draft>
          )}
        </div>
      </section>
    )
  }

  {
    illustrative.length > 0 && (
      <section class="section section--tight" aria-labelledby="g-illus">
        <div class="page">
          <header class="g-head">
            <h2 id="g-illus">Photographies <em>d’illustration</em></h2>
            <p class="label">Libres de droits · crédits ci-dessous</p>
          </header>
          <ul class="g-grid" role="list">
            {illustrative.map((p, i) => {
              const cap = p.credit ? `${p.slot.alt} Photo : ${p.credit.author}, ${p.credit.licence}.` : p.slot.alt;
              return (
                <li class:list={['g-item', 'reveal', i % 5 === 1 && 'g-item--tall']}>
                  <button type="button" class="g-thumb" data-lb data-lb-full={p.full} data-lb-alt={p.slot.alt} data-lb-caption={cap} aria-label={`Agrandir : ${p.slot.alt}`}>
                    <Picture src={p.img} alt="" formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes="(min-width: 60rem) 33vw, 92vw" loading="lazy" />
                  </button>
                  {p.credit && (
                    <p class="g-cap g-cap--credit">
                      {p.credit.author} · <a href={p.credit.sourceUrl} rel="noopener">{p.credit.licence}</a>
                    </p>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section g-art on-dark" aria-labelledby="g-art" data-sky="0.8">
    <div class="page">
      <header class="g-head">
        <h2 id="g-art">Le carnet <em>graphique</em></h2>
        <p class="label">Compositions originales ToutouBien</p>
      </header>
      <p class="lede g-art__lede">Les couleurs de ToutouBien viennent de son logo&nbsp;: le turquoise, le sarcelle et la nuit. Ces compositions accompagnent les pages du site&nbsp;; touchez-en une pour l’agrandir.</p>
      <ul class="g-art__grid" role="list">
        {ART.map((a, i) => (
          <li class:list={['reveal', `g-art__item--${i}`]}>
            <button type="button" class="g-art__thumb" data-lb data-lb-caption={`${a.title} — ${a.text}`} aria-label={`Agrandir : ${a.title}`}>
              <span data-lb-art class="g-art__art"><PlateArt motif={a.motif} /></span>
            </button>
            <p class="g-art__cap"><strong>{a.title}</strong>{a.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section on-lin g-next" aria-labelledby="g-next">
    <div class="page g-next__inner">
      <h2 id="g-next">Envie de nous <em>rencontrer</em>&nbsp;?</h2>
      <div class="g-next__links">
        <a class="btn" href="/contact/">Me contacter <Icon name="arrow" class="btn__arrow" /></a>
        <a class="link-arrow" href="/qui-suis-je/">Qui suis-je <Icon name="arrow" /></a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { initLightbox } from '~/scripts/lightbox';
  initLightbox();
</script>

<style>
  .gh {
    padding-block: var(--space-xl) var(--space-l);
    background: linear-gradient(180deg, var(--lin), var(--papier));
  }

  .gh__inner {
    display: grid;
    gap: var(--space-m);
  }

  .gh h1 {
    font-size: var(--step-6);
    line-height: 0.95;
    max-width: 12ch;
  }

  .gh h1 :global(em),
  .g-head h2 em,
  .g-next h2 em {
    color: var(--sarcelle);
  }

  .gh .lede {
    max-width: 60ch;
  }

  .g-head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-m);
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-l);
  }

  .g-grid {
    display: grid;
    gap: var(--space-s);
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    grid-auto-rows: 15rem;
    grid-auto-flow: dense;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .g-item--wide {
      grid-column: span 2;
    }

    .g-item--tall {
      grid-row: span 2;
    }
  }

  .g-item {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-l);
  }

  .g-thumb {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: var(--lin);
    cursor: zoom-in;
  }

  .g-thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s var(--ease-out);
  }

  .g-thumb:hover :global(img),
  .g-thumb:focus-visible :global(img) {
    transform: scale(1.05);
  }

  .g-thumb:focus-visible,
  .g-art__thumb:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: -3px;
  }

  .g-cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 2rem 0.9rem 0.7rem;
    background: linear-gradient(transparent, rgb(8 30 28 / 0.75));
    color: var(--craie);
    font-size: var(--step--1);
    pointer-events: none;
  }

  .g-cap--credit a {
    color: inherit;
    pointer-events: auto;
  }

  .g-slot {
    display: grid;
    place-items: center;
    padding: var(--space-m);
    border-radius: var(--radius-l);
    border: 1.5px dashed color-mix(in oklab, var(--sarcelle) 55%, transparent);
    background: repeating-linear-gradient(-45deg, transparent 0 12px, color-mix(in oklab, var(--turquoise) 10%, transparent) 12px 13px);
    text-align: center;
    font-size: var(--step--1);
    color: var(--encre-douce);
  }

  .g-art {
    background: radial-gradient(110% 90% at 50% 0%, #12403d, var(--nuit) 65%);
  }

  .g-art h2 em {
    color: var(--lagon);
  }

  .g-art__lede {
    max-width: 56ch;
    margin-bottom: var(--space-l);
  }

  .g-art__grid {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    padding: 0;
    list-style: none;
  }

  @media (min-width: 64rem) {
    .g-art__grid {
      grid-template-columns: repeat(6, 1fr);
    }

    .g-art__item--0,
    .g-art__item--1 {
      grid-column: span 3;
    }

    .g-art__item--2,
    .g-art__item--3,
    .g-art__item--4 {
      grid-column: span 2;
    }
  }

  .g-art__thumb {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--radius-l);
    overflow: hidden;
    background: none;
    cursor: zoom-in;
  }

  .g-art__art {
    display: block;
    aspect-ratio: 4 / 3;
    transition: transform 1s var(--ease-out);
  }

  .g-art__thumb:hover .g-art__art {
    transform: scale(1.04);
  }

  .g-art__art :global(.plate-art),
  .g-art__art :global(svg) {
    width: 100%;
    height: 100%;
  }

  .g-art__cap {
    display: grid;
    gap: 0.15rem;
    margin-top: var(--space-xs);
    color: var(--craie-douce);
    font-size: var(--step--1);
  }

  .g-art__cap strong {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-1);
    color: var(--craie);
  }

  .g-next__inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    align-items: center;
    justify-content: space-between;
  }

  .g-next__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    align-items: center;
  }
</style>
