---
/**
 * Galerie des photos authentiques de l'activité (src/assets/photos/galerie/).
 * N'affiche que les photos pourvues d'un texte alternatif dans src/content/galerie.json :
 * rien n'apparaît tant que Mme Petitgand n'a pas fourni ses images.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import meta from '~/content/galerie.json';

interface Props {
  title?: string;
}
const { title = 'En images' } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/galerie/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const info = meta as Record<string, { alt?: string; legende?: string }>;
const photos = Object.entries(files)
  .map(([path, mod]) => ({ name: path.split('/').pop()!, img: mod.default, ...info[path.split('/').pop()!] }))
  .filter((p): p is typeof p & { alt: string } => typeof p.alt === 'string' && p.alt.trim().length > 0);
---
{
  photos.length > 0 && (
    <section class="section gallery" aria-labelledby="gallery-title">
      <div class="page">
        <h2 id="gallery-title" class="gallery__title">{title}</h2>
        <ul class="gallery__grid" role="list">
          {photos.map((p, i) => (
            <li class:list={['gallery__item', i % 5 === 0 && 'gallery__item--wide']}>
              <figure>
                <Picture src={p.img} alt={p.alt} formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes="(min-width: 60rem) 33vw, 92vw" loading="lazy" />
                {p.legende && <figcaption>{p.legende}</figcaption>}
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .gallery__title {
    margin-bottom: var(--space-l);
  }

  .gallery__grid {
    display: grid;
    gap: var(--space-s);
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    grid-auto-flow: dense;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .gallery__item--wide {
      grid-column: span 2;
    }
  }

  .gallery figure {
    display: grid;
    gap: var(--space-2xs);
    margin: 0;
  }

  .gallery :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-m);
  }

  .gallery figcaption {
    font-size: var(--step--1);
    color: var(--encre-douce);
  }
</style>
