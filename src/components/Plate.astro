---
/**
 * « Planche » éditoriale : affiche la photo associée à un emplacement du registre
 * (src/content/photos.ts) ou, à défaut, une composition graphique originale.
 * Jamais de fausse photo, jamais de mention « image à venir » en public.
 */
import { Picture } from 'astro:assets';
import { PHOTO_SLOTS, photoFor, type PhotoSlotId, type PlateMotif } from '~/content/photos';
import PlateArt from './PlateArt.astro';

interface Props {
  id: PhotoSlotId;
  class?: string;
  /** Ratio imposé (sinon celui du registre). */
  ratio?: number;
  /** Image prioritaire (premier écran). */
  priority?: boolean;
  sizes?: string;
  shape?: 'rect' | 'arch' | 'round';
  reveal?: boolean;
}

const { id, class: className, ratio: forcedRatio, priority = false, sizes = '(min-width: 64rem) 45vw, 92vw', shape = 'rect', reveal = true } = Astro.props;
const slot = PHOTO_SLOTS[id];
const ratio = forcedRatio ?? slot.ratio;
const photo = photoFor(id);
const credit = 'credit' in slot ? (slot.credit as import('~/content/photos').PhotoCredit | undefined) : undefined;
const motif: PlateMotif = slot.motif;
---
<figure
  class:list={['plate', `plate--${shape}`, `plate--${motif}`, reveal && 'reveal-mask reveal-scale', className]}
  style={`--ratio: ${ratio}`}
  data-photo-slot={id}
  data-has-photo={photo ? 'true' : 'false'}
>
  {
    photo ? (
      <Picture
        src={photo}
        alt={slot.alt}
        formats={['avif', 'webp']}
        widths={[480, 800, 1200, 1600]}
        sizes={sizes}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        class="plate__img"
      />
    ) : (
      <PlateArt motif={motif} class="plate__art" />
    )
  }
  {photo && credit?.attributionRequired && <figcaption class="plate__credit">Photo : {credit.author}</figcaption>}
  <slot />
</figure>

<style>
  .plate {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    border-radius: var(--radius-l);
    background: var(--lin);
    isolation: isolate;
  }

  .plate--arch {
    border-radius: var(--radius-arch);
  }

  .plate--round {
    border-radius: 50%;
  }

  .plate :global(.plate__art),
  .plate :global(.plate__img),
  .plate :global(picture) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .plate :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }


  .plate__credit {
    position: absolute;
    right: var(--space-xs);
    bottom: var(--space-xs);
    padding: 0.15em 0.6em;
    border-radius: var(--radius-pill);
    background: rgb(15 27 26 / 0.7);
    color: var(--craie);
    font-size: 0.72rem;
  }
</style>
