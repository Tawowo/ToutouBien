---
/**
 * Ouverture de l'accueil : la relation humain-chien d'abord, en photographie.
 * Trois photos d'illustration composent une scène lumineuse ; une constellation relie la main,
 * le chien et le chemin, et fait apparaître les trois temps de l'accompagnement.
 * Mouvements autonomes très lents (respiration des étoiles, flottement des photos),
 * figés en mouvement réduit. Aucun effet ne recouvre le chien.
 */
import Photo from './Photo.astro';
import SplitTitle from './SplitTitle.astro';
import Icon from './Icon.astro';

// Étoiles de la constellation (repère 700 × 600, identique au cadre de la composition).
const STARS = [
  { x: 228, y: 352, r: 4 }, // le chiot
  { x: 452, y: 506, r: 5.5 }, // le chemin, aux pieds du chien
  { x: 604, y: 452, r: 4.5 }, // le bord du chemin, à côté du duo
  { x: 648, y: 212, r: 3.5 }, // la truffe dans les feuilles
];
const LINKS: [number, number][] = [
  [0, 1],
  [1, 2],
  [2, 3],
];
const WORDS = [
  { x: 120, y: 584, lines: ['Comprendre'], anchor: 'middle' },
  { x: 640, y: 540, lines: ['Observer'], anchor: 'end' },
  { x: 36, y: 74, lines: ['Avancer', 'ensemble'], anchor: 'start' },
];
---
<section class="hh" aria-labelledby="hh-title">
  <div class="hh__light" aria-hidden="true"></div>
  <div class="page hh__grid">
    <div class="hh__text">
      <p class="eyebrow enter">Éducation canine · accompagnement des familles</p>
      <SplitTitle as="h1" id="hh-title" class="hh__title" text="Comprendre son chien, *se sentir bien* ensemble." now />
      <p class="lede enter" data-i="4">ToutouBien accompagne les familles et leur chien pour que le quotidien redevienne plus simple, à la maison comme en balade.</p>
      <div class="hh__actions enter" data-i="5">
        <a class="btn" href="/parlons-de-votre-chien/">Parlons de votre chien <Icon name="arrow" class="btn__arrow" /></a>
        <a class="link-arrow" href="/orientation/">Par où commencer&nbsp;? <Icon name="arrow" /></a>
      </div>
      <ul class="hh__keys enter" data-i="6" role="list">
        <li><span class="hh__dot" aria-hidden="true"></span>Chiot, chien adulte, vie quotidienne</li>
        <li><span class="hh__dot" aria-hidden="true"></span>À la maison et en balade</li>
      </ul>
    </div>

    <div class="hh__scene" data-hh-scene>
      <Photo id="lien-coucher-soleil" class="hh__main" shape="arch" ratio="4-5" priority sizes="(min-width: 60rem) 34vw, 70vw" alt="Un chien tricolore, tenu en laisse, sur un chemin au coucher du soleil ; seule la main de la personne est visible." />
      <Photo id="chiot-exploration" class="hh__round" shape="round" sizes="(min-width: 60rem) 15vw, 34vw" />
      <Photo id="flair-feuillage" class="hh__card" shape="soft" ratio="1" sizes="(min-width: 60rem) 13vw, 30vw" />
      <svg class="hh__sky" viewBox="0 0 700 600" aria-hidden="true" focusable="false">
        {LINKS.map(([a, b], i) => (
          <line x1={STARS[a]!.x} y1={STARS[a]!.y} x2={STARS[b]!.x} y2={STARS[b]!.y} pathLength="1" class="hh__ray" data-i={i} />
        ))}
        {STARS.map((s, i) => (
          <g class="hh__star" data-i={i}>
            <circle cx={s.x} cy={s.y} r={s.r * 4} class="hh__halo" />
            <circle cx={s.x} cy={s.y} r={s.r} class="hh__core" />
          </g>
        ))}
        {WORDS.map((w, i) => (
          <text x={w.x} y={w.y} text-anchor={w.anchor} class="hh__word" data-i={i}>
            {w.lines.map((l, k) => <tspan x={w.x} dy={k ? '1.05em' : 0}>{l}</tspan>)}
          </text>
        ))}
      </svg>
    </div>
  </div>
  <p class="hh__note page">Photos d’illustration · crédits sur chaque image</p>
</section>

<style>
  .hh {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-l) var(--space-xl);
    background: linear-gradient(180deg, var(--aube) 0%, var(--papier) 70%);
  }

  .hh__light {
    position: absolute;
    inset: -20% -10% auto auto;
    width: 70vw;
    height: 70vw;
    max-width: 62rem;
    max-height: 62rem;
    border-radius: 50%;
    background: radial-gradient(circle, var(--soleil) 0%, rgb(255 244 220 / 0.55) 35%, transparent 68%);
    pointer-events: none;
  }

  .hh__light::after {
    content: '';
    position: absolute;
    left: -70%;
    bottom: -60%;
    width: 80%;
    height: 80%;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(154 211 205 / 0.45), transparent 70%);
  }

  .hh__grid {
    position: relative;
    display: grid;
    gap: var(--space-l);
    align-items: center;
  }

  @media (min-width: 60rem) {
    .hh__grid {
      grid-template-columns: 5fr 6fr;
      min-height: min(100svh - 8rem, 50rem);
    }
  }

  .hh__text {
    display: grid;
    gap: var(--space-m);
    align-content: center;
  }

  .hh__title {
    font-size: var(--step-6);
    line-height: 0.95;
    max-width: 12ch;
  }

  .hh__title :global(em) {
    color: var(--sarcelle);
  }

  .hh .lede {
    max-width: 44ch;
  }

  .hh__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-m);
    align-items: center;
  }

  .hh__keys {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-m);
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
    color: var(--encre-douce);
  }

  .hh__keys li {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .hh__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--turquoise);
    box-shadow: 0 0 0 4px rgb(17 150 147 / 0.15);
  }

  /* Scène : cadre de 7 × 6 dans lequel photos et étoiles partagent le même repère. */
  .hh__scene {
    position: relative;
    aspect-ratio: 7 / 6;
    width: 100%;
    max-width: 44rem;
    justify-self: center;
  }

  .hh__scene > :global(.ph) {
    position: absolute;
  }

  .hh__scene :global(.hh__main) {
    left: 26%;
    top: 0;
    width: 54%;
    box-shadow: 0 2.5rem 4rem -2.5rem rgb(20 60 55 / 0.55);
    border-radius: 999px 999px var(--radius-l) var(--radius-l);
  }

  .hh__scene :global(.hh__round) {
    left: 4%;
    top: 52%;
    width: 31%;
    z-index: 2;
    padding: 0.45rem;
    border-radius: 50%;
    background: var(--blanc);
    box-shadow: 0 1.5rem 3rem -1.8rem rgb(20 60 55 / 0.5);
  }

  .hh__scene :global(.hh__card) {
    right: 0;
    top: 6%;
    width: 22%;
    z-index: 2;
    padding: 0.4rem;
    border-radius: calc(var(--radius-l) + 0.4rem);
    background: var(--blanc);
    box-shadow: 0 1.5rem 3rem -1.8rem rgb(20 60 55 / 0.5);
  }

  .hh__scene :global(.hh__card .ph__credit),
  .hh__scene :global(.hh__round .ph__credit) {
    font-size: 0.58rem;
  }

  .hh__sky {
    position: absolute;
    inset: 0;
    z-index: 3;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .hh__ray {
    stroke: var(--turquoise);
    stroke-width: 1.4;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    opacity: 0.85;
  }

  .hh__halo {
    fill: rgb(255 255 255 / 0.55);
    transform-box: fill-box;
    transform-origin: center;
  }

  .hh__core {
    fill: var(--blanc);
    stroke: var(--turquoise);
    stroke-width: 2;
  }

  .hh__word {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 30px;
    fill: var(--sarcelle);
    paint-order: stroke;
    stroke: var(--aube);
    stroke-width: 7px;
    stroke-linejoin: round;
  }

  .hh__note {
    position: relative;
    margin-top: var(--space-s);
    font-size: var(--step--2);
    color: var(--encre-douce);
    text-align: right;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hh__ray {
      stroke-dashoffset: 1;
      animation: hh-draw 1.4s var(--ease-out) forwards;
    }

    .hh__ray[data-i='0'] {
      animation-delay: 0.9s;
    }

    .hh__ray[data-i='1'] {
      animation-delay: 1.4s;
    }

    .hh__ray[data-i='2'] {
      animation-delay: 1.9s;
    }


    .hh__star {
      opacity: 0;
      animation: hh-pop 0.7s var(--ease-out) forwards;
    }

    .hh__star[data-i='0'] {
      animation-delay: 0.7s;
    }

    .hh__star[data-i='1'] {
      animation-delay: 1.2s;
    }

    .hh__star[data-i='2'] {
      animation-delay: 1.7s;
    }

    .hh__star[data-i='3'] {
      animation-delay: 2.2s;
    }

    .hh__halo {
      animation: hh-breathe 4.2s ease-in-out infinite;
    }

    .hh__star[data-i='1'] .hh__halo,
    .hh__star[data-i='3'] .hh__halo {
      animation-duration: 5.4s;
      animation-delay: 1.2s;
    }

    .hh__word {
      opacity: 0;
      animation: hh-word 0.9s var(--ease-out) forwards;
    }

    .hh__word[data-i='0'] {
      animation-delay: 2s;
    }

    .hh__word[data-i='1'] {
      animation-delay: 2.6s;
    }

    .hh__word[data-i='2'] {
      animation-delay: 3.2s;
    }

    .hh__scene :global(.hh__round) {
      animation: hh-float 9s ease-in-out infinite;
    }

    .hh__scene :global(.hh__card) {
      animation: hh-float 11s ease-in-out -4s infinite;
    }
  }

  @keyframes hh-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes hh-pop {
    from {
      opacity: 0;
      transform: scale(0.3);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes hh-breathe {
    50% {
      transform: scale(1.35);
      opacity: 0.6;
    }
  }

  @keyframes hh-word {
    from {
      opacity: 0;
      transform: translateY(8px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes hh-float {
    50% {
      transform: translateY(-10px);
    }
  }

  .hh__star {
    transform-box: fill-box;
    transform-origin: center;
  }

  @media (max-width: 59.99rem) {
    .hh {
      padding-top: var(--space-s);
    }

    .hh__scene {
      order: -1;
      width: min(100%, 26rem);
    }

    .hh__word {
      font-size: 36px;
    }

    .hh__title {
      font-size: var(--step-5);
    }
  }
</style>
