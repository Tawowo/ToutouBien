---
import Icon from './Icon.astro';
import Emblem from '~/assets/brand/emblem.svg';
import Wordmark from '~/assets/brand/wordmark-nom.svg';
import { CTA_NAV, NAV_GROUPS, PRIMARY_NAV } from '~/config/navigation';
import { visibleArticles } from '~/lib/articles';
import { site } from '~/config/site';

interface Props {
  theme?: 'light' | 'dark';
}
const { theme = 'light' } = Astro.props;
const hasArticles = (await visibleArticles()).length > 0;
const groups = NAV_GROUPS.map((g) => ({ ...g, items: g.items.filter((i) => i.href !== '/ressources/' || hasArticles) }));
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
let n = 0;
---
<header class:list={['site-header', `site-header--${theme}`, theme === 'dark' && 'on-dark']} data-header>
  <div class="site-header__inner page">
    <a href="/" class="brand" aria-label="ToutouBien, retour à l’accueil">
      <Emblem class="brand__emblem" aria-hidden="true" />
      <Wordmark class="brand__word" aria-hidden="true" />
    </a>

    <nav class="quick-nav" aria-label="Accès rapide">
      <ul role="list">
        {
          PRIMARY_NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a href={CTA_NAV.href} class:list={['btn btn--sm header-cta', theme === 'dark' && 'btn--lagon']}>
        <span>{CTA_NAV.label}</span>
        <Icon name="arrow" class="btn__arrow" />
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu-complet" data-menu-toggle>
        <span class="menu-toggle__label" data-menu-label>Menu</span>
        <span class="menu-toggle__bars" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>

  <nav id="menu-complet" class="menu on-dark grain-dark" aria-label="Menu complet" data-menu>
    <div class="menu__inner page">
      <div class="menu__groups">
        {
          groups.map((group) => (
            <section class="menu__group" aria-labelledby={`menu-${group.title}`}>
              <h2 class="label" id={`menu-${group.title}`}>{group.title}</h2>
              <ul role="list">
                {group.items.map((item) => {
                  n += 1;
                  return (
                    <li>
                      <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
                        <span class="menu__num" aria-hidden="true">{String(n).padStart(2, '0')}</span>
                        <span class="menu__text">{item.label}</span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </section>
          ))
        }
      </div>
      <aside class="menu__aside">
        <Emblem class="menu__emblem" aria-hidden="true" />
        <p class="menu__tagline">{site.tagline.value}</p>
        <a href={CTA_NAV.href} class="btn btn--lagon">
          {CTA_NAV.label}
          <Icon name="arrow" class="btn__arrow" />
        </a>
      </aside>
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');
  if (header && toggle && menu) {
    const focusables = () => [toggle, ...menu.querySelectorAll<HTMLElement>('a')];
    const setOpen = (open: boolean, restoreFocus = false) => {
      toggle.setAttribute('aria-expanded', String(open));
      header.classList.toggle('is-open', open);
      document.documentElement.classList.toggle('menu-open', open);
      if (label) label.textContent = open ? 'Fermer' : 'Menu';
      if (open) menu.querySelector<HTMLElement>('a')?.focus();
      else if (restoreFocus) toggle.focus();
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (event) => {
      if (!header.classList.contains('is-open')) return;
      if (event.key === 'Escape') setOpen(false, true);
      // Le focus reste dans le menu ouvert.
      if (event.key === 'Tab') {
        const items = focusables();
        const first = items[0]!;
        const last = items[items.length - 1]!;
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });
    // En-tête compact après le premier écran.
    let last = 0;
    addEventListener(
      'scroll',
      () => {
        const y = scrollY;
        header.classList.toggle('is-scrolled', y > 40);
        header.classList.toggle('is-hidden', y > 400 && y > last && !header.classList.contains('is-open'));
        last = y;
      },
      { passive: true },
    );
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    view-transition-name: site-header;
    transition: transform var(--dur) var(--ease-out), background-color var(--dur) ease;
  }

  .site-header--light {
    background: color-mix(in oklab, var(--papier) 96%, transparent);
    border-bottom: 1px solid color-mix(in oklab, var(--encre) 8%, transparent);
  }

  .site-header--dark {
    background: var(--nuit);
  }

  .site-header.is-hidden {
    transform: translateY(-100%);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    min-height: 4.75rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--sarcelle);
    text-decoration: none;
    min-height: 2.75rem;
    flex: none;
  }

  .site-header--dark .brand {
    color: var(--lagon);
  }

  .brand__emblem {
    width: 2.7rem;
    height: auto;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .brand:hover .brand__emblem {
    transform: rotate(-6deg) scale(1.06);
  }

  .brand__word {
    width: 8rem;
    height: auto;
  }

  .site-header--dark .brand__word {
    color: var(--craie);
  }

  .quick-nav {
    margin-inline: auto;
  }

  .quick-nav ul {
    display: flex;
    gap: var(--space-m);
    padding: 0;
    list-style: none;
  }

  .quick-nav a {
    position: relative;
    display: inline-block;
    padding-block: 0.7rem;
    color: inherit;
    font-weight: 500;
    text-decoration: none;
  }

  .quick-nav a::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.35rem;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: var(--accent);
    transform: translateX(-50%) scale(0);
    transition: transform var(--dur) var(--ease-out);
  }

  .site-header--dark .quick-nav a::after {
    background: var(--lueur);
  }

  .quick-nav a:hover::after,
  .quick-nav a[aria-current='page']::after {
    transform: translateX(-50%) scale(1);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-left: auto;
  }

  .quick-nav + .site-header__actions {
    margin-left: 0;
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0 0.6rem 0 1rem;
    border: 1.5px solid currentColor;
    border-radius: var(--radius-pill);
    background: transparent;
    font-weight: 600;
    cursor: pointer;
  }

  .menu-toggle__bars {
    position: relative;
    display: grid;
    gap: 5px;
    width: 1.8rem;
    height: 1.8rem;
    place-content: center;
    border-radius: 50%;
    background: currentColor;
  }

  .menu-toggle__bars span {
    display: block;
    width: 0.85rem;
    height: 1.5px;
    background: var(--papier);
    transition: transform var(--dur) var(--ease-out);
  }

  .site-header--dark .menu-toggle__bars span {
    background: var(--nuit);
  }

  .is-open .menu-toggle__bars span:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .is-open .menu-toggle__bars span:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  /* ---- Menu plein écran ---- */
  .menu {
    position: fixed;
    inset: 4.75rem 0 0 0;
    overflow-y: auto;
    visibility: hidden;
    clip-path: inset(0 0 100% 0);
    transition: clip-path 600ms var(--ease-in-out), visibility 0s linear 600ms;
  }

  .is-open .menu {
    visibility: visible;
    clip-path: inset(0 0 0 0);
    transition-delay: 0s;
  }

  .menu__inner {
    display: grid;
    gap: var(--space-xl);
    padding-block: var(--space-l) var(--space-xl);
    min-height: 100%;
  }

  @media (min-width: 64rem) {
    .menu__inner {
      grid-template-columns: 3fr 1fr;
      align-items: start;
    }
  }

  .menu__groups {
    display: grid;
    gap: var(--space-l);
  }

  @media (min-width: 48rem) {
    .menu__groups {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .menu__group ul {
    display: grid;
    margin-top: var(--space-s);
    padding: 0;
    list-style: none;
  }

  .menu__group a {
    display: grid;
    grid-template-columns: 2rem 1fr;
    align-items: baseline;
    gap: 0.4rem;
    padding-block: 0.55rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
    color: var(--craie) !important;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.1;
    transition: color var(--dur-fast) ease, padding var(--dur) var(--ease-out);
  }

  .menu__group a:hover,
  .menu__group a[aria-current='page'] {
    color: var(--lueur) !important;
    padding-left: 0.4rem;
  }

  .menu__num {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--lagon);
  }

  @media (prefers-reduced-motion: no-preference) {
    .is-open .menu__group li {
      animation: enter 700ms var(--ease-out) both;
    }

    .is-open .menu__group li:nth-child(2) { animation-delay: 60ms; }
    .is-open .menu__group li:nth-child(3) { animation-delay: 120ms; }
    .is-open .menu__group li:nth-child(4) { animation-delay: 180ms; }
    .is-open .menu__group li:nth-child(5) { animation-delay: 240ms; }
  }

  .menu__aside {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
  }

  .menu__emblem {
    width: min(14rem, 50vw);
    height: auto;
    color: var(--lagon);
  }

  .menu__tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-2);
    color: var(--craie-douce);
  }

  :global(html.menu-open) {
    overflow: hidden;
  }

  .quick-nav a,
  .header-cta {
    white-space: nowrap;
  }

  /* Les liens rapides n'apparaissent que s'ils tiennent sur une ligne ; le menu complet reste disponible. */
  @media (max-width: 74.99rem) {
    .quick-nav {
      display: none;
    }
  }

  @media (max-width: 47.99rem) {
    .header-cta {
      display: none;
    }
  }

  @media (max-width: 30rem) {
    .brand__word {
      width: 6.6rem;
    }
  }

  /* Sans JavaScript : le menu complet s'affiche sous l'en-tête. */
  :global(.no-js) .menu {
    position: static;
    visibility: visible;
    clip-path: none;
  }

  :global(.no-js) .menu-toggle {
    display: none;
  }
</style>
