# Copiez ce fichier en `.env` et complétez les valeurs. Ne commitez jamais `.env`.

# URL publique définitive du site (sans barre finale). Sert aux canoniques, au sitemap
# et aux métadonnées de partage. Obligatoire avant la mise en ligne.
PUBLIC_SITE_URL=

# Autorise l'indexation par les moteurs de recherche. Laisser à `false` tant que
# les contenus bloquants (voir docs/CONTENT-VALIDATION.md) ne sont pas validés.
PUBLIC_ALLOW_INDEXING=false

# Affiche les contenus non validés (avec un marquage visible) dans une préproduction.
# Ne jamais activer en production.
PUBLIC_SHOW_DRAFTS=false

# Transmission des formulaires — voir docs/DEPLOYMENT.md et docs/PRIVACY-AND-SECURITY.md
# PUBLIC_FORM_PROVIDER : `formspree`, `web3forms` ou `custom` (laisser vide = envoi en ligne désactivé)
PUBLIC_FORM_PROVIDER=
# Formspree / custom : URL complète du point de réception (ex. https://formspree.io/f/xxxxxxx)
PUBLIC_FORM_ENDPOINT=
# Web3Forms : clé d'accès publique (conçue pour être exposée côté navigateur)
PUBLIC_WEB3FORMS_ACCESS_KEY=
