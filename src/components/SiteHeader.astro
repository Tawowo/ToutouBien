---
import Icon from './Icon.astro';
import Emblem from '~/assets/brand/emblem.svg';
import Wordmark from '~/assets/brand/wordmark-nom.svg';
import { CTA_NAV, PRIMARY_NAV } from '~/config/navigation';
import { visibleArticles } from '~/lib/articles';

interface Props {
  theme?: 'light' | 'dark';
}
const { theme = 'light' } = Astro.props;
const hasArticles = (await visibleArticles()).length > 0;
const items = PRIMARY_NAV.filter((item) => item.href !== '/ressources/' || hasArticles);
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href)) || (href === '/ressources/' && path.startsWith('/blog/'));
---
<header class:list={['site-header', `site-header--${theme}`, theme === 'dark' && 'on-dark']} data-header>
  <div class="site-header__inner page">
    <a href="/" class="brand" aria-label="ToutouBien, retour à l’accueil">
      <Emblem class="brand__emblem" aria-hidden="true" />
      <Wordmark class="brand__word" aria-hidden="true" />
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu-principal" data-menu-toggle>
      <span class="menu-toggle__label" data-menu-label>Menu</span>
      <Icon name="menu" class="menu-toggle__icon menu-toggle__icon--open" />
      <Icon name="close" class="menu-toggle__icon menu-toggle__icon--close" />
    </button>

    <nav id="menu-principal" class="site-nav" aria-label="Navigation principale" data-menu>
      <ul class="site-nav__list" role="list">
        {
          items.map((item) => (
            <li>
              <a href={item.href} class="site-nav__link" aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a href={CTA_NAV.href} class:list={['btn', theme === 'dark' ? 'btn--lagon' : '', 'site-nav__cta']} aria-current={isCurrent(CTA_NAV.href) ? 'page' : undefined}>
        {CTA_NAV.label}
        <Icon name="arrow" class="btn__arrow" />
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const header = document.querySelector<HTMLElement>('[data-header]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');
  if (toggle && menu && header) {
    const setOpen = (open: boolean, restoreFocus = false) => {
      toggle.setAttribute('aria-expanded', String(open));
      header.classList.toggle('is-open', open);
      document.body.classList.toggle('menu-open', open);
      if (label) label.textContent = open ? 'Fermer' : 'Menu';
      if (open) menu.querySelector<HTMLElement>('a')?.focus();
      else if (restoreFocus) toggle.focus();
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && header.classList.contains('is-open')) setOpen(false, true);
    });
    // Fermeture si l'on repasse en affichage large.
    window.matchMedia('(min-width: 60rem)').addEventListener('change', (e) => e.matches && setOpen(false));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--ivoire) 97%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid color-mix(in oklab, var(--encre) 8%, transparent);
  }

  .site-header--dark {
    background: var(--nuit);
    border-bottom-color: rgb(255 255 255 / 0.06);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    min-height: 4.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--sarcelle);
    text-decoration: none;
    flex: none;
    min-height: 2.75rem;
  }

  .site-header--dark .brand {
    color: var(--lagon);
  }

  .brand__emblem {
    width: 2.6rem;
    height: auto;
  }

  .brand__word {
    width: 8.4rem;
    height: auto;
    transform: translateY(0.1rem);
  }

  .site-header--dark .brand__word {
    color: var(--craie);
  }

  .menu-toggle {
    display: none;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 0.9rem;
    border: 1.5px solid currentColor;
    border-radius: var(--radius-pill);
    background: transparent;
    font-weight: 600;
    cursor: pointer;
  }

  .menu-toggle__icon {
    width: 1.3rem;
    height: 1.3rem;
  }

  .menu-toggle__icon--close,
  .is-open .menu-toggle__icon--open {
    display: none;
  }

  .is-open .menu-toggle__icon--close {
    display: block;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--space-l);
  }

  .site-nav__list {
    display: flex;
    gap: var(--space-m);
    padding: 0;
    list-style: none;
  }

  .site-nav__link {
    position: relative;
    display: inline-block;
    padding-block: 0.6rem;
    color: inherit;
    font-weight: 500;
    text-decoration: none;
  }

  .site-nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.3rem;
    height: 1.5px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur) var(--ease-out);
  }

  .site-nav__link:hover::after,
  .site-nav__link[aria-current='page']::after {
    transform: scaleX(1);
  }

  .site-nav__link:hover {
    color: inherit;
  }

  .site-nav__cta {
    min-height: 2.75rem;
    padding-block: 0.6em;
    font-size: var(--step--1);
  }

  @media (max-width: 59.99rem) {
    :global(.js) .menu-toggle {
      display: inline-flex;
    }

    .brand__word {
      width: 7.2rem;
    }

    /* Sans JavaScript : la navigation reste visible, sous l'en-tête. */
    :global(.no-js) .site-header__inner {
      flex-wrap: wrap;
      padding-block: var(--space-xs);
    }

    :global(.no-js) .site-nav {
      width: 100%;
      flex-wrap: wrap;
      gap: var(--space-s);
    }

    :global(.no-js) .site-nav__list {
      flex-wrap: wrap;
    }

    :global(.js) .site-nav {
      position: fixed;
      inset: 4.5rem 0 auto 0;
      height: calc(100dvh - 4.5rem);
      flex-direction: column;
      align-items: stretch;
      justify-content: space-between;
      padding: var(--space-l) var(--gutter) var(--space-xl);
      background: var(--nuit);
      color: var(--craie);
      visibility: hidden;
      opacity: 0;
      transform: translateY(-0.75rem);
      transition: opacity var(--dur) var(--ease-out), transform var(--dur) var(--ease-out), visibility 0s linear var(--dur);
      overflow-y: auto;
    }

    :global(.js) .is-open .site-nav {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition-delay: 0s;
    }

    :global(.js) .site-nav__list {
      flex-direction: column;
      gap: 0;
    }

    :global(.js) .site-nav__link {
      display: block;
      padding-block: var(--space-s);
      border-bottom: 1px solid rgb(255 255 255 / 0.12);
      font-family: var(--font-display);
      font-size: var(--step-3);
      font-weight: 350;
    }

    :global(.js) .site-nav__link::after {
      display: none;
    }

    :global(.js) .site-nav__link[aria-current='page'] {
      color: var(--lagon);
    }

    :global(.js) .site-nav__cta {
      --btn-bg: var(--lagon);
      --btn-fg: var(--nuit);
      min-height: 3.25rem;
      font-size: var(--step-0);
    }
  }

  :global(body.menu-open) {
    overflow: hidden;
  }
</style>
